# Group CSV by cohort, compute count and mean age. Output JSON.
let meta = csv("data/metadata.csv")
let grouped = meta |> group_by("cohort")
let cohort_names = keys(grouped) |> sort()
let results = {}
cohort_names |> each(|name| {
    let rows = grouped[name]
    let ages = col_values(rows, "age") |> map(|v| float(v))
    let m = round(mean(ages), 6)
    results[name] = {count: len(rows), mean_age: m}
})
let output = {groups: results}
println(json_pretty(output))
