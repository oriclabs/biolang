# Count canonical 5-mers from first sequence in FASTA. Output JSON.
let seqs = read_fasta("data/sequences.fa")
let first = seqs |> head(1)
let seq = first[0].seq
let k = 5

# kmers() returns the raw windows; canonicalising needs the encoded form, so
# encode, fold each k-mer onto the lexicographically smaller of itself and its
# reverse complement, and decode back to a string. Without this the task
# reported 744 distinct 5-mers where the strand-agnostic answer is 468, while
# still calling the field unique_canonical.
let kmer_list = kmer_encode(seq, k) |> map(|x| kmer_decode(kmer_canonical(x)))
let counts = frequencies(kmer_list)
let total = len(kmer_list)
let unique_count = len(keys(counts))

# Sort by count descending, then k-mer ascending. Counts tie constantly at this
# k, so without the second key the top 20 is whichever 20 the hash happened to
# yield and no two implementations would ever agree.
let sorted_pairs = keys(counts)
    |> map(|key| {kmer: key, count: counts[key]})
    |> sort_by(|a, b| if a.count != b.count { b.count - a.count }
                      else { if a.kmer < b.kmer { -1 } else { 1 } })
    |> head(20)
let top = {}
sorted_pairs |> each(|p| { top[p.kmer] = p.count })

let output = {sequence_id: first[0].id, k: k, total_kmers: total,
              unique_canonical: unique_count, top_20: top}
println(json_pretty(output))
