# Count E. coli annotation features by type. Output JSON.
let lines = read_lines("real_data/ecoli_annotation.gff")
let rows = lines |> filter(|l| not starts_with(l, "#") and trim(l) != "")
let by_type = {}
rows |> each(|l| {
    let parts = split(l, "\t")
    if len(parts) >= 3 {
        let t = parts[2]
        by_type[t] = if has_key(by_type, t) { by_type[t] + 1 } else { 1 }
    }
})
println(json_pretty({total_features: len(rows), by_type: by_type}))
