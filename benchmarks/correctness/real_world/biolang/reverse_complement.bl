# Reverse complement the first 200 bases of the first 5 sequences. Output JSON.
let seqs = read_fasta("real_data/yeast_genome.fa") |> head(5)
let results = seqs |> map(|s| {
    let sub = upper(substr(str(s.seq), 0, 200))
    {id: s.id, original: sub, revcomp: str(reverse_complement(dna(sub)))}
})
println(json_pretty({sequences: results}))
