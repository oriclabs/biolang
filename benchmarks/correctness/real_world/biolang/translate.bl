# Translate the first 99 bases of the first 3 sequences. Output JSON.
let seqs = read_fasta("real_data/yeast_genome.fa") |> head(3)
let results = seqs |> map(|s| {
    let sub = upper(substr(str(s.seq), 0, 99))
    {id: s.id, dna: sub, protein: str(translate(transcribe(dna(sub))))}
})
println(json_pretty({translations: results}))
