# Assembly statistics over the S. cerevisiae genome. Output JSON.
let seqs = read_fasta("real_data/yeast_genome.fa")
let lengths = seqs |> map(|s| seq_len(s.seq))
let total = sum(lengths)
# Length-weighted GC, matching the reference: sum(gc_i * len_i) / sum(len_i),
# which is not the same as the mean of the per-sequence fractions.
let weighted = seqs |> map(|s| gc_content(s.seq) * float(seq_len(s.seq))) |> sum()
let overall_gc = weighted / float(total)
let output = {n_sequences: len(lengths), total_length: total,
              n50: n50(lengths), gc_content: overall_gc}
println(json_pretty(output))
