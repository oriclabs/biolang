# Group ClinVar variants by clinical significance. Output JSON.
let rows = csv("real_data/clinvar_variants.csv")
let grouped = rows |> group_by("clnsig")
let result = {}
keys(grouped) |> each(|sig| {
    let g = grouped[sig]
    let lens = col_values(g, "var_len") |> map(|v| float(v))
    result[sig] = {count: len(g), mean_var_len: sum(lens) / float(len(g))}
})
println(json_pretty({groups: result}))
