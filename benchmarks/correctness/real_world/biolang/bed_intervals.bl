# E. coli gene intervals: count, span, per-chromosome, merged count. Output JSON.
let ivs = read_bed("real_data/ecoli_genes.bed")
let n = len(ivs)
let total_span = ivs |> map(|iv| iv.end - iv.start) |> sum()
let per_chrom = {}
ivs |> count_by("chrom") |> each(|r| { per_chrom[r.key] = r.count })
let output = {n_intervals: n, total_span: total_span,
              per_chromosome: per_chrom, merged_count: len(merge_intervals(ivs))}
println(json_pretty(output))
