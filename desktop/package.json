{
  "name": "biolang-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "generate:help": "node scripts/generate-help.mjs",
    "check:help": "node scripts/check-help.mjs",
    "check:examples": "node scripts/check-examples.mjs",
    "dev": "vite",
    "prebuild": "npm run generate:help && npm run check:help",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "studio:dev": "tauri dev --config src-tauri/studio.conf.json",
    "studio:build": "tauri build --config src-tauri/studio.conf.json",
    "test:studio-stress": "cargo test --manifest-path src-tauri/Cargo.toml --lib tests::studio_one_gib_copy_and_hash_remains_streamed -- --ignored --exact --nocapture",
    "pretest": "npm run generate:help && npm run check:help && npm run check:examples",
    "test": "playwright test",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@somer/client": "file:./vendor/somer-client-0.1.3.tgz",
    "@tauri-apps/api": "^2.8.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.52.2",
    "ngl": "^2.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tauri-apps/cli": "^2.8.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.7"
  }
}
