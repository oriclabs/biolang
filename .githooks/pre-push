#!/bin/sh
#
# Catch three things that CI would otherwise find minutes later:
#   - generated files that no longer match their sources
#   - a committed WASM module that no longer matches the runtime
#   - published figures in the MSMB companion that have moved
#
# Enable with:
#   git config core.hooksPath .githooks
#
# Skip a single push with `git push --no-verify`.

set -e

node scripts/check-generated.mjs

# Only when the runtime changed: rebuilding WASM is the expensive fix, and a
# push that touches no Rust cannot have invalidated the module.
if ! git diff --quiet HEAD origin/main -- crates 2>/dev/null; then
    node scripts/check-wasm-fresh.mjs
fi

# Only worth running when the interpreter or the companion actually changed;
# the scripts take a couple of minutes end to end.
if git diff --quiet HEAD origin/main -- crates books/msmb 2>/dev/null; then
    echo "MSMB figures: unchanged since origin/main, skipping."
else
    node scripts/check-msmb.mjs
fi
