# survival/src/cox.bl — Cox proportional hazards model utilities
#
# Wraps the core cox_ph() builtin and adds convenience wrappers for
# univariate screening, formatted hazard ratio tables, and Harrell's C-index.
#
# Core builtins used: cox_ph, mean, round, abs, sqrt, exp, log2

## cox(times, events, covariates, covariate_names?) → Record
##
## Fit a Cox proportional hazards model.
## Wraps the core cox_ph() builtin and attaches covariate names to the result.
##
## times           — List<Float> follow-up times
## events          — List<Int>   event indicators (1=event, 0=censored)
## covariates      — List<List<Float>> design matrix; one inner list per covariate,
##                   each of length len(times)
## covariate_names — optional List<String> of covariate labels
##
## Returns the cox_ph() result augmented with a "covariate_names" field.
fn cox(times, events, covariates, covariate_names = nil) {
    let result = cox_ph(times, events, covariates)

    # Attach names if provided
    let names = if covariate_names != nil {
        covariate_names
    } else {
        range(0, len(covariates)) |> map(|i| f"X{i + 1}")
    }

    {... result, covariate_names: names}
}

## cox_univariate(times, events, covariate_table) → List<Record>
##
## Run a separate Cox model for every covariate column in covariate_table.
## Useful for univariate screening before building a multivariate model.
##
## times             — List<Float>
## events            — List<Int>
## covariate_table   — List<Record> where each key (except reserved ones) is a covariate
##                     The function will ignore any "patient_id" or "sample_id" columns.
##
## Returns: List<Record{covariate, hr, hr_lower_ci, hr_upper_ci, pvalue}> sorted by pvalue
fn cox_univariate(times, events, covariate_table) {
    if len(covariate_table) == 0 {
        return []
    }

    let skip_cols = ["patient_id", "sample_id", "id", "subject_id"]
    let first_row = covariate_table[0]
    let cov_names = keys(first_row) |> filter(|k| not (k |> in_list(skip_cols)))

    let results = cov_names |> map(|cov_name| {
        # Extract this covariate as a single-column design matrix
        let cov_values = covariate_table |> map(|row| row[cov_name])
        let cov_matrix = [cov_values]

        let fit = cox_ph(times, events, cov_matrix)

        # Extract the single coefficient result
        let coef = fit.coefficients[0]
        let se   = fit.standard_errors[0]
        let z    = coef / se
        let hr   = exp(coef)

        # Wald confidence interval on HR scale
        let z_95 = 1.96
        let hr_lo = exp(coef - z_95 * se)
        let hr_hi = exp(coef + z_95 * se)

        # Two-tailed p-value from z score
        let z_abs = abs(z)
        let pval = if z_abs >= 5.0 then 0.0000006
                   else if z_abs >= 4.0 then 0.000063
                   else if z_abs >= 3.5 then 0.000465
                   else if z_abs >= 3.0 then 0.0027
                   else if z_abs >= 2.5 then 0.0124
                   else if z_abs >= 2.0 then 0.0455
                   else if z_abs >= 1.96 then 0.05
                   else if z_abs >= 1.5 then 0.1336
                   else if z_abs >= 1.0 then 0.3173
                   else 0.5 + z_abs * 0.05

        {
            covariate:   cov_name,
            hr:          round(hr,   4),
            hr_lower_ci: round(hr_lo, 4),
            hr_upper_ci: round(hr_hi, 4),
            coef:        round(coef, 4),
            se:          round(se,   4),
            z_stat:      round(z,    4),
            pvalue:      round(pval, 6)
        }
    })

    results |> sort_by(|r| r.pvalue)
}

## hazard_ratio_table(cox_result) → List<Record>
##
## Format a multivariate Cox result as a display-ready hazard ratio table.
## Requires that the cox_result was produced by cox() (which attaches covariate_names).
##
## cox_result — result from cox()
##
## Returns: List<Record{covariate, hr, lower_95ci, upper_95ci, pvalue, stars}>
fn hazard_ratio_table(cox_result) {
    let names   = cox_result.covariate_names
    let coefs   = cox_result.coefficients
    let ses     = cox_result.standard_errors
    let n_covs  = len(names)

    let z_95 = 1.96
    let result = []

    for i in range(0, n_covs) {
        let coef  = coefs[i]
        let se    = ses[i]
        let hr    = exp(coef)
        let hr_lo = exp(coef - z_95 * se)
        let hr_hi = exp(coef + z_95 * se)
        let z     = coef / se
        let z_abs = abs(z)

        let pval  = if z_abs >= 5.0 then 0.0000006
                    else if z_abs >= 4.0 then 0.000063
                    else if z_abs >= 3.0 then 0.0027
                    else if z_abs >= 2.0 then 0.0455
                    else if z_abs >= 1.5 then 0.1336
                    else 0.5 + z_abs * 0.05

        let stars = if pval < 0.001 then "***"
                    else if pval < 0.01 then "**"
                    else if pval < 0.05 then "*"
                    else "ns"

        result = append(result, {
            covariate:   names[i],
            hr:          round(hr,    3),
            lower_95ci:  round(hr_lo, 3),
            upper_95ci:  round(hr_hi, 3),
            pvalue:      round(pval,  6),
            stars:       stars
        })
    }

    result
}

## c_index(times, events, predicted_risk) → Record
##
## Harrell's C-index (concordance statistic) — the probability that for a
## randomly chosen pair of subjects, the one with the higher predicted risk
## experiences the event first.
##
## times          — List<Float> observed follow-up times
## events         — List<Int>   event indicators (1=event, 0=censored)
## predicted_risk — List<Float> model-predicted risk scores (higher = more risk)
##
## Returns: Record{c_index, concordant_pairs, discordant_pairs, tied_pairs}
## Interpretation: 0.5 = random, 0.7 = acceptable, 0.8 = excellent
fn c_index(times, events, predicted_risk) {
    let n = len(times)
    let concordant = 0
    let discordant = 0
    let tied       = 0

    # Compare all pairs (i, j) where i had the event
    for i in range(0, n) {
        if events[i] != 1 {
            continue
        }
        for j in range(0, n) {
            if i == j {
                continue
            }
            # Subject i had the event — comparable only if j was event-free at i's time
            # or j also had an event (at any time)
            if times[j] > times[i] or (events[j] == 1 and times[j] >= times[i]) {
                if predicted_risk[i] > predicted_risk[j] {
                    concordant = concordant + 1
                } else if predicted_risk[i] < predicted_risk[j] {
                    discordant = discordant + 1
                } else {
                    tied = tied + 1
                }
            }
        }
    }

    let total = concordant + discordant + tied
    let ci = if total > 0 then (concordant + 0.5 * tied) / total else 0.5

    {
        c_index:          round(ci, 4),
        concordant_pairs: concordant,
        discordant_pairs: discordant,
        tied_pairs:       tied,
        total_pairs:      total
    }
}
