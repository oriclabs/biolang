# singlecell/src/core.bl — Object creation and basic accessors
#
# The sc object is a plain BioLang Record that grows as pipeline steps
# add results. Starting shape (from load/from_matrix):
#
#   { matrix, genes, barcodes, n_cells, n_genes }
#
# Pipeline steps add optional fields:
#   norm_matrix, hvg, hvg_matrix, hvg_genes, knn, clusters,
#   pseudotime, doublet_scores, cell_cycle_info

## load(path) → Record
##
## Read a 10x Genomics MEX directory (barcodes.tsv, features.tsv, matrix.mtx,
## with optional .gz variants) and return a single-cell object.
fn load(path) {
    _with_contract(read_10x_sparse(path))
}

## Attach the stable single-cell object contract to a runtime reader result.
## Legacy top-level fields remain available for older BioLang packages.
fn _with_contract(obj) {
    let layers = if contains(keys(obj), "layers") { obj.layers } else { {counts: obj.matrix} }
    let result = {... obj,
        profile: "biolang",
        active_assay: "RNA",
        assays: {RNA: {layers: layers, variable_features: []}},
        reductions: {},
        graphs: {},
        idents: []
    }
    # Constructors fail at the boundary instead of allowing a mislabeled axis
    # to travel into normalization, PCA, markers, or plots.
    sc_validate_object(result, true)
    result
}

## Rows of a dense matrix as List<List<Float>>.
##
## `matrix(...)` builds a Matrix value, but the object model stores counts as
## List<List> (dense) or SparseMatrix (from load). Normalising here keeps every
## downstream step — merge, subset, matrix_at — looking at one of two shapes
## instead of three.
fn _as_rows(m) {
    if typeof(m) == "Matrix" {
        let shape = dim(m)
        return range(0, shape[0]) |> map(|i| row(m, i))
    }
    m
}

## from_matrix(matrix, genes, barcodes) → Record
##
## Construct a single-cell object from an existing dense matrix
## (cells × genes). Accepts either a `matrix(...)` value or a List<List<Float>>.
fn from_matrix(matrix, genes, barcodes) {
    let rows = _as_rows(matrix)
    _with_contract({
        matrix:   rows,
        genes:    genes,
        barcodes: barcodes,
        n_cells:  len(rows),
        n_genes:  len(genes),
        obs:       table(barcodes |> map(|barcode| {barcode: barcode})),
        var:       table(genes |> map(|gene| {gene: gene})),
        layers:    {counts: rows},
        is_sparse: false
    })
}

## validate(obj, strict) -> Record
##
## Check matrix dimensions and, more importantly, cell/feature identity across
## names, layers, assays, selected features, annotations, and reductions.
## The default returns a structured report. Pass true to stop on the first
## invalid object boundary.
fn validate(obj, strict = false) {
    sc_validate_object(obj, strict)
}

## assert_valid(obj) -> Record
## Validate strictly, then return the original object for use in a pipeline.
fn assert_valid(obj) {
    sc_validate_object(obj, true)
    obj
}

## n_cells(obj) → Int
fn n_cells(obj) { obj.n_cells }

## n_genes(obj) → Int
fn n_genes(obj) { obj.n_genes }

## get_matrix(obj) → List<List<Float>>
## Returns the raw count matrix (cells × genes).
fn get_matrix(obj) { obj.matrix }

## get_norm_matrix(obj) → List<List<Float>>
## Returns the normalized matrix (after normalize or sctransform).
fn get_norm_matrix(obj) { obj.norm_matrix }

## get_genes(obj) → List<Str>
fn get_genes(obj) { obj.genes }

## get_barcodes(obj) → List<Str>
fn get_barcodes(obj) { obj.barcodes }

## get_hvg_genes(obj) → List<Str>
## Returns highly variable gene names (after variable_genes step).
fn get_hvg_genes(obj) { obj.hvg_genes }

## get_clusters(obj) → List<Int>
## Returns cluster assignment per cell (after cluster step).
fn get_clusters(obj) { obj.clusters }

## get_pseudotime(obj) → List<Float>
## Returns pseudotime per cell (after pseudotime step). -1.0 = unreachable.
fn get_pseudotime(obj) { obj.pseudotime }

## get_doublet_scores(obj) → List<Float>
## Returns doublet scores per cell (after doublets step).
fn get_doublet_scores(obj) { obj.doublet_scores }

## summary(obj) → Record
## Returns a summary record with basic statistics about the object.
fn summary(obj) {
    let n_c = obj.n_cells
    let n_g = obj.n_genes

    let metrics = cell_qc(obj.matrix, obj.genes)
    let mean_lib = mean(col(metrics, "total_counts"))
    let mean_genes = mean(col(metrics, "n_genes"))

    {
        n_cells:        n_c,
        n_genes:        n_g,
        mean_lib_size:  mean_lib,
        mean_genes_per_cell: mean_genes,
        has_norm:       "norm_matrix" in keys(obj),
        has_hvg:        "hvg" in keys(obj),
        has_pca:        "pca_scores" in keys(obj),
        has_neighbors:  "knn" in keys(obj),
        has_clusters:   "clusters" in keys(obj),
        has_pseudotime: "pseudotime" in keys(obj)
    }
}
