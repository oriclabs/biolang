# singlecell/src/plots.bl — plots that take the sc object directly
#
# The plotting builtins want shapes the sc object does not have: umap_plot needs
# a List<Record> with x/y columns, but umap() returns a Matrix; violin needs a
# Table whose columns are the groups. Every function here does that conversion,
# so a clustered object goes straight into a figure:
#
#   let res = obj |> sc.normalize() |> sc.variable_genes(2000)
#                 |> sc.neighbors(15) |> sc.cluster_leiden(15, 1.0)
#   write_text("umap.svg", sc.plot_umap(res))
#   write_text("markers.svg", sc.plot_markers(res, 5))
#
# Functions returning SVG return it as a Str — write it to a file, or embed it.

# ── helpers ───────────────────────────────────────────────────────────────────

## The most processed matrix available: HVG > normalised > raw.
fn _matrix_of(obj) {
    let k = keys(obj)
    if contains(k, "integrated_matrix") {
        return obj.integrated_matrix
    }
    if contains(k, "hvg_matrix") {
        return obj.hvg_matrix
    }
    if contains(k, "norm_matrix") {
        return obj.norm_matrix
    }
    obj.matrix
}

## Full expression matrix for named-gene plots. HVG matrices are suitable for
## embeddings but would make unselected marker genes disappear from feature,
## violin, and dot plots.
fn _expression_matrix_of(obj) {
    if contains(keys(obj), "norm_matrix") {
        return obj.norm_matrix
    }
    obj.matrix
}

## Per-cell group label as Str, so plots colour by cluster when one exists.
fn _labels(obj) {
    let k = keys(obj)
    if contains(k, "clusters") {
        return obj.clusters |> map(|c| _cluster_label(c))
    }
    range(0, obj.n_cells) |> map(|i| "cell")
}

## table() orders columns lexicographically, so an unpadded "cluster 10" would
## sort between "cluster 1" and "cluster 2". Zero-padding keeps groups in
## numeric order in violin and heatmap output.
fn _cluster_label(c) {
    "cluster " + pad_left(str(c), 2, "0")
}

## Rows of a Matrix as a List<List<Float>>. `umap`/`pca` return Matrix values,
## which cannot be indexed with [i].
fn _rows(m, n) {
    range(0, n) |> map(|i| row(m, i))
}

## Sorted distinct cluster ids.
fn _cluster_ids(obj) {
    obj.clusters |> unique |> sort
}

## Cell indices belonging to a cluster.
fn _cells_in(obj, c) {
    range(0, obj.n_cells) |> filter(|i| obj.clusters[i] == c)
}

## Index against the full gene list used by _expression_matrix_of.
fn _expression_gene_index(obj, gene) {
    find_index(obj.genes, |g| g == gene)
}

## A non-finite value. violin() drops non-finite entries per column, which is how
## ragged per-cluster groups fit into a rectangular Table.
fn _pad() { log(0.0) }

# ── embeddings ────────────────────────────────────────────────────────────────

## plot_umap(obj, title) → Str (SVG)
##
## UMAP of the HVG matrix, coloured by cluster. Equivalent to Seurat's DimPlot.
fn plot_umap(obj, title = "UMAP") {
    let base = if contains(keys(obj), "pca_scores") {
        obj.pca_scores
    } else {
        sc_pca(_matrix_of(obj), 30).scores
    }
    let emb = if contains(keys(obj), "umap") { obj.umap } else {
        umap(base, 2, {n_neighbors: 30, n_epochs: 500, min_dist: 0.3,
                       metric: "cosine", seed: 42})
    }
    let labs = _labels(obj)
    let pts = _rows(emb, obj.n_cells) |> map(|r| {x: r[0], y: r[1]})
    let with_labels = range(0, obj.n_cells)
        |> map(|i| {... pts[i], cluster: labs[i]})
    umap_plot(with_labels, {title: title})
}

## plot_pca(obj, title) → Str (SVG)
##
## First two principal components, coloured by cluster.
fn plot_pca(obj, title = "PCA") {
    let p = if contains(keys(obj), "pca") { obj.pca } else { sc_pca(_matrix_of(obj), 2) }
    let labs = _labels(obj)
    let sc_rows = p.scores
    let pts = range(0, obj.n_cells) |> map(|i| {
        let r = sc_rows[i]
        {x: r[0], y: r[1], cluster: labs[i]}
    })
    umap_plot(pts, {title: title})
}

## dim_plot(obj, groups, title, label) -> Str (SVG)
##
## Seurat/ggplot-style DimPlot. This is the R-familiar presentation layer;
## `plot_umap` remains available for compatibility with older BioLang figures.
fn dim_plot(obj, groups = nil, title = "UMAP", label = false) {
    let base = if contains(keys(obj), "pca_scores") {
        obj.pca_scores
    } else {
        sc_pca(_matrix_of(obj), 30).scores
    }
    let emb = if contains(keys(obj), "umap") { obj.umap } else {
        umap(base, 2, {n_neighbors: 30, n_epochs: 500, min_dist: 0.3,
                       metric: "cosine", seed: 42})
    }
    let labels = if groups == nil {
        if contains(keys(obj), "clusters") {
            obj.clusters |> map(|cluster| str(cluster))
        } else {
            range(0, obj.n_cells) |> map(|_| "cell")
        }
    } else {
        groups |> map(|group| str(group))
    }
    if len(labels) != obj.n_cells {
        error("sc.dim_plot() needs one group label per cell")
    }
    let rows = _rows(emb, obj.n_cells)
    let points = range(0, obj.n_cells) |> map(|i| {
        {x: rows[i][0], y: rows[i][1], cluster: labels[i]}
    })
    umap_plot(points, {
        title: title, theme: "seurat", label_groups: label,
        point_size: if obj.n_cells > 5000 { 1.6 } else { 2.4 }
    })
}

## plot_feature(obj, gene, title) → Str (SVG)
##
## UMAP coloured by one gene's expression on a continuous ramp — Seurat's
## FeaturePlot. Emits its own SVG because umap_plot colours by a categorical
## column and cannot express a gradient.
fn plot_feature(obj, gene, title = nil) {
    let gi = _expression_gene_index(obj, gene)
    if gi < 0 {
        return "gene '" + gene + "' not found"
    }
    let m = _expression_matrix_of(obj)
    let vals = range(0, obj.n_cells) |> map(|i| matrix_at(m, i, gi))
    let base = if contains(keys(obj), "pca_scores") { obj.pca_scores } else { sc_pca(m, 30).scores }
    let emb = if contains(keys(obj), "umap") { obj.umap } else {
        umap(base, 2, {n_neighbors: 30, n_epochs: 500, min_dist: 0.3,
                       metric: "cosine", seed: 42})
    }
    let rows = _rows(emb, obj.n_cells)
    _scatter_svg(
        rows |> map(|r| r[0]),
        rows |> map(|r| r[1]),
        vals,
        if title == nil { gene } else { title },
        gene
    )
}

## feature_plot(obj, gene, title) -> Str (SVG)
##
## Seurat-style FeaturePlot: low expression is light grey and high expression
## is blue. The cell layer rasterises automatically for large datasets.
fn feature_plot(obj, gene, title = nil) {
    let gi = _expression_gene_index(obj, gene)
    if gi < 0 { return "gene '" + gene + "' not found" }
    let m = _expression_matrix_of(obj)
    let values = range(0, obj.n_cells) |> map(|i| matrix_at(m, i, gi))
    let base = if contains(keys(obj), "pca_scores") { obj.pca_scores } else { sc_pca(m, 30).scores }
    let emb = if contains(keys(obj), "umap") { obj.umap } else {
        umap(base, 2, {n_neighbors: 30, n_epochs: 500, min_dist: 0.3,
                       metric: "cosine", seed: 42})
    }
    let rows = _rows(emb, obj.n_cells)
    let points = range(0, obj.n_cells) |> map(|i| {
        {x: rows[i][0], y: rows[i][1], value: values[i]}
    })
    umap_plot(points, {
        title: if title == nil { gene } else { title },
        feature: "value", feature_label: gene, theme: "seurat",
        point_size: if obj.n_cells > 5000 { 1.6 } else { 2.4 }
    })
}

## Scatter with a continuous colour ramp, used by plot_feature and the QC
## plots. Any per-cell numeric vector can be shown this way — pseudotime,
## doublet score, mitochondrial fraction.
##
## Delegates to the `umap_plot` builtin rather than emitting SVG here. The old
## hand-rolled loop wrote one <circle> per cell and grew the parts list with
## `parts = parts + [...]`, which copies the whole list each time — quadratic.
## On a raw 10x matrix (737,280 droplets) that did not finish, and the SVG it
## was building would have been tens of megabytes of vector shapes no reader
## can interact with anyway. The builtin rasterises the point layer above five
## thousand points and keeps axes, labels and the colour key as vector text.
fn _scatter_svg(xs, ys, vals, title, legend, xlab = "", ylab = "") {
    let points = range(0, len(xs)) |> map(|i| {x: xs[i], y: ys[i], value: vals[i]})
    umap_plot(points, {title: title, feature: "value", feature_label: legend,
                       xlab: xlab, ylab: ylab})
}

## Continuous colour ramp over 0..1: light grey -> blue -> red.
fn _ramp(t) {
    let u = if t < 0.0 { 0.0 } else { if t > 1.0 { 1.0 } else { t } }
    if u < 0.5 {
        let k = u / 0.5
        return "rgb(" + str(int(222.0 - 152.0 * k)) + "," +
               str(int(226.0 - 116.0 * k)) + "," + str(int(232.0 + 5.0 * k)) + ")"
    }
    let k = (u - 0.5) / 0.5
    "rgb(" + str(int(70.0 + 170.0 * k)) + "," + str(int(110.0 - 80.0 * k)) + "," +
        str(int(237.0 - 180.0 * k)) + ")"
}

# ── distributions ─────────────────────────────────────────────────────────────

## plot_violin(obj, gene) → Str (SVG)
##
## One gene's expression per cluster. Seurat's VlnPlot.
fn plot_violin(obj, gene) {
    let gi = _expression_gene_index(obj, gene)
    if gi < 0 {
        return "gene '" + gene + "' not found"
    }
    let m = _expression_matrix_of(obj)
    let ids = _cluster_ids(obj)
    let groups = ids |> map(|c| _cells_in(obj, c) |> map(|i| matrix_at(m, i, gi)))
    let width = groups |> map(|g| len(g)) |> max

    # Table rows are rectangular, so short columns are padded with a non-finite
    # value that violin() discards.
    let rows = range(0, width) |> map(|r| {
        let cells = range(0, len(ids)) |> map(|k|
            if r < len(groups[k]) { groups[k][r] } else { _pad() })
        _record_of(ids |> map(|c| _cluster_label(c)), cells)
    })
    violin(table(rows), {title: gene, ylab: "log-normalised expression"})
}

## vln_plot(obj, gene, title) -> Str (SVG)
##
## R-familiar VlnPlot with unpadded identity labels and a visible median.
fn vln_plot(obj, gene, title = nil) {
    let gi = _expression_gene_index(obj, gene)
    if gi < 0 { return "gene '" + gene + "' not found" }
    let m = _expression_matrix_of(obj)
    let rows = _cluster_ids(obj) |> map(|cluster| {
        _cells_in(obj, cluster) |> map(|i| {
            {expression: matrix_at(m, i, gi), ident: str(cluster)}
        })
    }) |> flatten
    violin_plot(rows, {
        value: "expression", group: "ident",
        title: if title == nil { gene } else { title }, theme: "seurat"
    })
}

## Build a Record from parallel key/value lists. Record literals cannot have
## computed keys and there is no set-key builtin, so this round-trips through
## JSON — the only way to name a field at runtime.
fn _record_of(names, values) {
    let parts = range(0, len(names)) |> map(|i| {
        # JSON has no infinity or NaN, and str(log(0.0)) is "-inf", which
        # json_parse rejects. The ragged-column padding below is exactly such a
        # value. It only shows up when groups differ in length, so an evenly
        # sized test fixture never triggered it and real clusters — 3128 cells
        # against 32 — do immediately. null round-trips and is still non-finite
        # to the consumers that drop padding.
        let v = values[i]
        let text = if typeof(v) == "Float" and not is_finite(v) { "null" } else { str(v) }
        "\"" + replace(str(names[i]), "\"", "'") + "\": " + text
    })
    json_parse("{" + join(parts, ", ") + "}")
}

# ── markers ───────────────────────────────────────────────────────────────────

## plot_markers(obj, n_per_cluster) → Str (SVG)
##
## Heatmap of mean expression of the top markers of each cluster, genes x
## clusters. The analogue of Seurat's DoHeatmap.
fn plot_markers(obj, n_per_cluster = 5) {
    let ids = _cluster_ids(obj)
    let m = _matrix_of(obj)
    let names = if contains(keys(obj), "hvg_genes") { obj.hvg_genes } else { obj.genes }

    # Pick each cluster's most distinctive genes by (in-cluster mean) - (rest mean).
    let picked = []
    for c in ids {
        let inside = _cells_in(obj, c)
        let outside = range(0, obj.n_cells) |> filter(|i| obj.clusters[i] != c)
        if len(inside) > 0 and len(outside) > 0 {
            let scored = range(0, len(names)) |> map(|g| {
                gene: names[g],
                diff: mean(inside |> map(|i| matrix_at(m, i, g))) -
                      mean(outside |> map(|i| matrix_at(m, i, g)))
            })
            let top = scored
                |> sort(|a, b| if a.diff > b.diff { -1 } else { 1 })
                |> take(n_per_cluster)
                |> map(|x| x.gene)
            for g in top {
                if not contains(picked, g) { picked = picked + [g] }
            }
        }
    }

    let rows = picked |> map(|g| {
        let gi = find_index(names, |x| x == g)
        let vals = ids |> map(|c| mean(_cells_in(obj, c) |> map(|i| matrix_at(m, i, gi))))
        {... _record_of(ids |> map(|c| _cluster_label(c)), vals), gene: g}
    })
    let cluster_labels = ids |> map(|c| _cluster_label(c))
    let marker_matrix = matrix_from_table(table(rows), cluster_labels)
    clustered_heatmap(marker_matrix, {
        title: "Top markers per cluster", subtitle: "Mean expression by cluster",
        caption: "Rows and columns use deterministic nearest-neighbour ordering",
        legend_title: "mean expression", row_labels: picked,
        col_labels: cluster_labels, theme: "publication"
    })
}

## Ordered ASCII bars. bar_chart() takes a Record, and records are unordered
## hash maps, so it cannot render a sequence — an elbow plot came out as
## PC4, PC1, PC3, PC5, PC2. These draw the bars directly to keep the order.
fn _ascii_bars(labels, values, width = 40) {
    let top = values |> max
    let scale = if top > 0.0 { top } else { 1.0 }
    let pad = labels |> map(|l| len(l)) |> max
    for i in range(0, len(labels)) {
        let n = int(float(width) * values[i] / scale)
        println("  " + pad_right(labels[i], pad, " ") + " |" +
                str_repeat("#", n) + " " + str(round(values[i], 2)))
    }
}

## plot_elbow(obj, n_pcs) → Str (SVG)
##
## Variance explained per principal component, in PC order, for choosing how
## many components to keep. Read where the curve flattens.
## `elbow_plot` has no option to limit the components it draws, so the slice
## happens here — otherwise `n_pcs` would be silently inert whenever the object
## already carried a PCA with more components than the caller asked to see.
fn plot_elbow(obj, n_pcs = 15) {
    let p = if contains(keys(obj), "pca") { obj.pca } else { sc_pca(_matrix_of(obj), n_pcs) }
    let r = p.explained_variance_ratio
    let n = if len(r) < n_pcs { len(r) } else { n_pcs }
    elbow_plot(r |> take(n), {title: "variance explained per PC"})
}

fn _bar_colour(i) {
    let colours = ["#2563eb", "#dc2626", "#059669", "#d97706", "#7c3aed",
                   "#0891b2", "#be185d", "#4d7c0f", "#475569", "#9333ea"]
    colours[i % len(colours)]
}

## plot_proportions(obj, groups) → Str (SVG)
##
## Cells per cluster, or per supplied label when `groups` is given. Sorted by
## group name so repeated runs are comparable.
##
## Written out as SVG rather than delegating to `bar_chart`, which is an ASCII
## builtin — every other plot_* here returns SVG and the exception was a trap.
fn plot_proportions(obj, groups = nil, title = "cells per group") {
    let labs = if groups == nil { _labels(obj) } else { groups }
    let ids = labs |> unique |> sort
    let counts = ids |> map(|g| float(labs |> filter(|l| l == g) |> len))
    let top = counts |> reduce(|a, b| if a > b { a } else { b }, 0.0)

    let n = len(ids)
    let bar_h = 26
    let gap = 8
    let left = 90
    let plot_w = 420
    let h = 60 + n * (bar_h + gap)
    let w = left + plot_w + 70

    let bars = range(0, n) |> map(|i| {
        let y = 48 + i * (bar_h + gap)
        let frac = if top > 0.0 { counts[i] / top } else { 0.0 }
        let bw = frac * float(plot_w)
        "<text x=\"" + str(left - 8) + "\" y=\"" + str(y + 17) +
        "\" font-family=\"sans-serif\" font-size=\"12\" text-anchor=\"end\" " +
        "fill=\"#334155\">" + str(ids[i]) + "</text>" +
        "<rect x=\"" + str(left) + "\" y=\"" + str(y) + "\" width=\"" + str(bw) +
        "\" height=\"" + str(bar_h) + "\" fill=\"" + _bar_colour(i) + "\" rx=\"2\"/>" +
        "<text x=\"" + str(float(left) + bw + 8.0) + "\" y=\"" + str(y + 17) +
        "\" font-family=\"sans-serif\" font-size=\"12\" fill=\"#475569\">" +
        str(int(counts[i])) + "</text>"
    })

    join(["<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"" + str(w) +
          "\" height=\"" + str(h) + "\" viewBox=\"0 0 " + str(w) + " " + str(h) + "\">",
          "<rect width=\"100%\" height=\"100%\" fill=\"#ffffff\"/>",
          "<text x=\"" + str(left) + "\" y=\"26\" font-family=\"sans-serif\" " +
          "font-size=\"15\" font-weight=\"bold\" fill=\"#0f172a\">" + title + "</text>",
          join(bars, ""), "</svg>"], "")
}

# ── dot plot ──────────────────────────────────────────────────────────────────

## expr_dotplot(obj, genes) → Str (SVG)
##
## Genes x clusters, circle area = fraction of cells expressing, circle colour =
## average expression standardized across clusters for that gene. These are
## Seurat DotPlot semantics; the `dotplot` builtin is a sequence dot-matrix and
## unrelated.
##
## Written as SVG here rather than delegating, because no builtin encodes two
## variables per cell.
fn expr_dotplot(obj, genes, title = "expression dot plot") {
    let m = _expression_matrix_of(obj)
    let names = obj.genes
    let ids = _cluster_ids(obj)

    let present = genes |> filter(|g| find_index(names, |x| x == g) >= 0)
    if len(present) == 0 {
        return "none of the requested genes are in this object"
    }

    let cell_w = 46
    let cell_h = 26
    let left = 110
    let top = 46
    # +200 reserves room for the legend text at font-size 9; the longest line
    # ("circle size = fraction expressing") needs ~150px and starts 16px in.
    let w = left + len(ids) * cell_w + 200
    let h = top + len(present) * cell_h + 40

    # Cluster membership, computed once. It used to be recomputed inside the
    # gene loop, so a 15-gene panel scanned every cell fifteen times per
    # cluster — on 15k cells that is 2.5M redundant comparisons before a single
    # value is read.
    let members = ids |> map(|c| _cells_in(obj, c))

    # Per (gene, cluster): fraction detected and average over all cells.
    let stats = present |> map(|g| {
        let gi = find_index(names, |x| x == g)
        range(0, len(ids)) |> map(|ci| {
            let cells = members[ci]
            let vals = cells |> map(|i| matrix_at(m, i, gi))
            let expressing = vals |> filter(|v| v > 0.0)
            {frac: if len(vals) > 0 { float(len(expressing)) / float(len(vals)) } else { 0.0 },
             average: if len(vals) > 0 { mean(vals) } else { 0.0 }}
        })
    })

    # Scale within each gene across identities, like Seurat's scale=TRUE.
    let scaled = stats |> map(|rowv| {
        let averages = rowv |> map(|s| s.average)
        let centre = mean(averages)
        let spread = if len(averages) > 1 { stdev(averages) } else { 0.0 }
        rowv |> map(|s| {
            let z = if spread > 0.0 { (s.average - centre) / spread } else { 0.0 }
            if z < -2.5 { -2.5 } else { if z > 2.5 { 2.5 } else { z } }
        })
    })

    let parts = ["<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"" + str(w) +
                 "\" height=\"" + str(h) + "\" viewBox=\"0 0 " + str(w) + " " + str(h) + "\">",
                 "<rect width=\"100%\" height=\"100%\" fill=\"#ffffff\"/>",
                 "<text x=\"" + str(left) + "\" y=\"22\" font-family=\"sans-serif\" " +
                 "font-size=\"14\" font-weight=\"bold\" fill=\"#0f172a\">" + title + "</text>"]

    for k in range(0, len(ids)) {
        parts = parts + ["<text x=\"" + str(left + k * cell_w + cell_w / 2) + "\" y=\"" +
            str(top - 8) + "\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#475569\" " +
            "text-anchor=\"middle\">" + str(ids[k]) + "</text>"]
    }

    for gi in range(0, len(present)) {
        let y = top + gi * cell_h + cell_h / 2
        parts = parts + ["<text x=\"" + str(left - 10) + "\" y=\"" + str(y + 4) +
            "\" font-family=\"monospace\" font-size=\"11\" fill=\"#0f172a\" " +
            "text-anchor=\"end\">" + present[gi] + "</text>"]
        for k in range(0, len(ids)) {
            let s = stats[gi][k]
            # Radius is sqrt(fraction), so circle area—not diameter—encodes %.
            let radius = 9.5 * sqrt(s.frac)
            let colour_t = (scaled[gi][k] + 2.5) / 5.0
            let low = int(211.0 * (1.0 - colour_t))
            let blue = int(211.0 + 44.0 * colour_t)
            let fill = "rgb(" + str(low) + "," + str(low) + "," + str(blue) + ")"
            parts = parts + ["<circle cx=\"" + str(left + k * cell_w + cell_w / 2) +
                "\" cy=\"" + str(y) + "\" r=\"" + str(round(radius, 2)) +
                "\" fill=\"" + fill + "\" stroke=\"#94a3b8\" stroke-width=\"0.5\"/>"]
        }
    }

    parts = parts + ["<text x=\"" + str(left + len(ids) * cell_w + 16) + "\" y=\"" +
        str(top + 6) + "\" font-family=\"sans-serif\" font-size=\"9\" fill=\"#475569\">" +
        "circle size = fraction expressing</text>",
        "<text x=\"" + str(left + len(ids) * cell_w + 16) + "\" y=\"" + str(top + 20) +
        "\" font-family=\"sans-serif\" font-size=\"9\" fill=\"#475569\">" +
        "colour = scaled average expression</text>", "</svg>"]

    join(parts, "\n")
}

## dot_plot and do_heatmap use the names familiar from Seurat documentation.
fn dot_plot(obj, genes, title = "DotPlot") { expr_dotplot(obj, genes, title) }
fn do_heatmap(obj, n_per_cluster = 5) { plot_markers(obj, n_per_cluster) }
