# singlecell/src/preprocess.bl — QC, normalization, and embedding
#
# Wraps core singlecell builtins for the common Seurat-style workflow:
#   filter_cells → normalize → variable_genes → scale → neighbors → cluster

## qc(obj) → Record
##
## Compute per-cell and per-gene QC metrics, adding them to obj.
##   obj.cell_qc_table — Table{cell_idx, total_counts, n_genes, pct_mito}
##   obj.gene_qc_table — Table{gene_idx, n_cells, mean_expression, pct_dropout}
fn qc(obj) {
    let cqc = cell_qc(obj.matrix, obj.genes)
    let gqc = gene_qc(obj.matrix, obj.genes)
    {... obj, cell_qc_table: cqc, gene_qc_table: gqc}
}

## filter_cells(obj, min_genes, max_genes, max_pct_mito) → Record
##
## Keep cells with gene counts in [min_genes, max_genes] and
## mitochondrial fraction ≤ max_pct_mito.
## Computes QC metrics on demand (does not require qc() to be called first).
fn filter_cells(obj, min_genes = 200, max_genes = 5000, max_pct_mito = 25.0) {
    let metrics = cell_qc(obj.matrix, obj.genes)
    let detected = col(metrics, "n_genes")
    let pct_mito = col(metrics, "pct_mito")
    let keep_idx = range(0, obj.n_cells) |> filter(|i| {
        detected[i] >= min_genes and detected[i] <= max_genes and
            pct_mito[i] <= max_pct_mito
    })
    sc_subset_cells(obj, keep_idx)
}

## filter_genes(obj, min_cells) → Record
##
## Keep genes expressed in at least min_cells cells.
fn filter_genes(obj, min_cells = 3) {
    let metrics = gene_qc(obj.matrix, obj.genes)
    let detected = col(metrics, "n_cells")
    let keep_gene_idx = range(0, obj.n_genes)
        |> filter(|j| detected[j] >= min_cells)
    sc_subset_genes(obj, keep_gene_idx)
}

## normalize(obj, target) → Record
##
## Library-size normalisation (counts per target) followed by log1p.
## Adds obj.norm_matrix (cells × genes).
fn normalize(obj, target = 10000.0) {
    let norm = normalize_total(obj.matrix, target) |> log1p_transform()
    # Objects from other packages (atac.activity, velocity) carry the core
    # fields but not always `layers`, so seed it from the raw counts rather
    # than failing on a field the producer was never required to set.
    let base = if contains(keys(obj), "layers") { obj.layers } else { {counts: obj.matrix} }
    let assays = if contains(keys(obj), "assays") { obj.assays } else { ({}) }
    let rna = if contains(keys(assays), "RNA") { assays.RNA } else { {layers: base, variable_features: []} }
    {... obj,
        norm_matrix: norm,
        norm_method: "lognorm",
        layers: {... base, lognorm: norm},
        assays: {... assays, RNA: {... rna, layers: {... base, data: norm, lognorm: norm}}}
    }
}

## sctransform(obj, n_features) → Record
##
## Regularised negative-binomial regression (Pearson residuals),
## clipped at ±sqrt(n_cells / 30) before centering and optional covariate
## regression. Adds obj.norm_matrix.
##
## Pearson residuals are dense by construction — `(0 - mu)/sqrt(var)` is not
## zero — so an uncapped result costs `n_cells * n_genes * 8` bytes whatever
## the input sparsity. At 29,629 cells and 16,681 genes that is about 4 GB.
##
## Pass `n_features` to keep only that many genes, ranked by the variance of
## their residuals. This is `SCTransform(variable.features.n = ...)`: the same
## residual values, fewer columns, and the cap bounds the dense peak rather
## than just the return value. The final matrix for 3,000 features on that
## object is 711 MB; parallel materialization adds at most one cell-length
## column per worker.
##
## A capped call also fills obj.hvg, obj.hvg_matrix and obj.hvg_genes, because
## ranking by residual variance *is* variable-gene selection under this
## normalization — there is no separate `variable_genes` step to run afterwards.
## covariates may be one numeric list or a list of numeric lists. They are
## removed from Pearson residuals in a second, non-regularized linear model,
## after residual-variance ranking. This is the vars.to.regress behavior used
## by Seurat's SCTransform wrapper.
fn sctransform(obj, n_features = 0, covariates = nil) {
    # Always returns {matrix, genes}. Completely zero genes are dropped, while
    # low-detection nonzero genes read regularized parameters from the fitted
    # expression trend. The surviving original-axis indices are never optional.
    let regressors = if covariates == nil { [] } else { covariates }
    let out = sc_sctransform(obj.matrix, n_features, regressors)
    let selected_genes = out.genes |> map(|j| obj.genes[j])
    let ranked_genes = out.ranked_genes |> map(|j| obj.genes[j])
    let assays = if contains(keys(obj), "assays") { obj.assays } else { ({}) }
    {... obj,
        active_assay: "SCT",
        norm_matrix: out.matrix,
        norm_method: "sctransform",
        hvg: out.genes,
        hvg_matrix: out.matrix,
        hvg_genes: selected_genes,
        hvg_ranked: out.ranked_genes,
        hvg_ranked_genes: ranked_genes,
        sct_theta: out.theta,
        sct_intercept: out.intercept,
        sct_residual_variance: out.residual_variance,
        sct_residual_variance_stage: out.residual_variance_stage,
        assays: {... assays, SCT: {
            layers: {data: out.matrix, scale_data: out.matrix},
            variable_features: selected_genes,
            model: "regularized_negative_binomial_v2_offset",
            ranked_features: ranked_genes,
            covariates_regressed: len(regressors)
        }}
    }
}

## variable_genes(obj, n) → Record
##
## Select the top n highly variable genes using the VST method described by
## Stuart et al. 2019. The variance trend is fitted on raw counts; the selected
## columns are then taken from the normalized matrix used downstream.
##
## Adds obj.hvg (List<Int>), obj.hvg_matrix (cells × HVGs),
## and obj.hvg_genes (List<Str>).
##
## **Do not call this on SCTransform output.** Dispersion divides by the square
## of the mean, and Pearson residuals are centred by construction — every gene's
## mean sits near zero, so the denominator is arithmetic noise rather than a
## scale. Ranking that way does not measure variability. It looks like it works,
## which is the problem: it produced a plausible gene list and a cluster count
## that appeared to reproduce a published result, and the agreement was a
## coincidence. Use `sctransform(obj, n)`, which ranks on residual variance.
fn variable_genes(obj, n = 2000) {
    if contains(keys(obj), "norm_method") and obj.norm_method == "sctransform" {
        error("sc.variable_genes() cannot run after sc.sctransform(): SCT may " +
              "drop zero-count genes, so the residual matrix no longer shares " +
              "the raw gene axis, and dispersion ranking is not meaningful on " +
              "centred residuals. Select features with sc.sctransform(obj, n).")
    }
    let mat = obj.norm_matrix
    let hvg_idx  = highly_variable_genes(obj.matrix, n, "vst")
    let hvg_mat  = select_cols(mat, hvg_idx)
    let hvg_g    = hvg_idx |> map(|j| obj.genes[j])
    let assays = if contains(keys(obj), "assays") { obj.assays } else { ({}) }
    let rna = if contains(keys(assays), "RNA") { assays.RNA } else { {layers: obj.layers} }
    {... obj,
        hvg: hvg_idx, hvg_matrix: hvg_mat, hvg_genes: hvg_g,
        hvg_method: "vst",
        assays: {... assays, RNA: {... rna, variable_features: hvg_g}}
    }
}

## run_pca(obj, n_pcs) -> Record
##
## Compute PCA from HVGs, normalized values, or raw counts, in that order.
## Sparse inputs remain sparse; only the compact cells-by-components score
## matrix is materialized.
##
## Batch correction happens after this step, not before: `integrate` corrects
## the scores this produces, and `neighbors` then prefers the corrected
## embedding. Re-running run_pca on an integrated object recomputes from
## expression and discards the correction.
fn run_pca(obj, n_pcs = 50) {
    let k = keys(obj)
    let mat = if contains(k, "scaled_matrix") {
        obj.scaled_matrix
    } else if contains(k, "hvg_matrix") {
        obj.hvg_matrix
    } else if contains(k, "norm_matrix") {
        obj.norm_matrix
    } else {
        obj.matrix
    }
    let result = sc_pca(mat, n_pcs)
    let reductions = if contains(k, "reductions") { obj.reductions } else { ({}) }
    {... obj,
        pca: result,
        pca_scores: result.scores,
        pca_loadings: result.loadings,
        reductions: {... reductions, pca: {
            embeddings: result.scores,
            loadings: result.loadings,
            explained_variance: result.explained_variance,
            explained_variance_ratio: result.explained_variance_ratio,
            key: "PC_"
        }}
    }
}

## scale(obj) → Record
##
## Per-gene mean-centering and unit-variance scaling of norm_matrix. Adds
## obj.scaled_matrix (cells × genes).
##
## Only selected variable features are materialized. This matches the standard
## PCA workflow without allocating a cells × full-transcriptome dense matrix.
fn scale(obj, clip = 10.0) {
    if not contains(keys(obj), "norm_matrix") {
        error("sc.scale() needs normalized values — call sc.normalize() first")
    }
    let mat = if contains(keys(obj), "hvg_matrix") { obj.hvg_matrix } else { obj.norm_matrix }
    # Native column moments and scaling avoid tens of millions of interpreted
    # closure calls and keep the result in one compact Matrix allocation.
    let scaled = sc_scale(mat, clip)
    let assays = if contains(keys(obj), "assays") { obj.assays } else { ({}) }
    let rna = if contains(keys(assays), "RNA") { assays.RNA } else { {layers: obj.layers} }
    let assay_layers = if contains(keys(rna), "layers") { rna.layers } else { obj.layers }
    {... obj,
        scaled_matrix: scaled,
        assays: {... assays, RNA: {... rna, layers: {... assay_layers, scale_data: scaled}}}
    }
}

## The embedding downstream steps should cluster on: the batch-corrected one
## when `integrate` has run, otherwise the raw PCA scores. Every consumer must
## agree on this, or the same object gives different answers depending on which
## step you call.
fn embedding_of(obj) {
    if contains(keys(obj), "integrated_embedding") {
        return obj.integrated_embedding
    }
    obj.pca_scores
}

## neighbors(obj, k, snn) → Record
##
## Build the neighbour graph on the PCA scores, or on the integrated embedding
## when `integrate` has run. Runs run_pca first if needed.
## Adds obj.knn (List<Record{source, target, weight}>).
##
## By default this is a **shared** nearest-neighbour graph: cells are joined by
## the Jaccard index of their neighbour sets rather than by how close they are,
## and edges at or below 1/15 are pruned. This is what `FindNeighbors` builds
## and what community detection should run on. Proximity alone is a poor signal
## in high dimensions — the distance to the nearest and to the furthest
## neighbour converge as dimensions grow — while neighbourhood overlap holds up.
##
## Pass `snn = false` for the older plain kNN graph weighted by 1/(1+distance).
## It is faster and worse, and it is kept so that results produced before the
## SNN graph existed can still be reproduced.
##
## Exact search, so cost is quadratic in n_cells.
fn neighbors(obj, k = 20, snn = true, n_dims = 10) {
    let prepared = if contains(keys(obj), "pca_scores") {
        obj
    } else {
        run_pca(obj)
    }
    let full = embedding_of(prepared)
    # Embeddings may be nested Lists (the historical PCA return type) or a
    # dense Matrix loaded through the process-isolated binary interchange.
    # `dim` handles both; row indexing is intentionally not supported by Matrix.
    # PCA historically returns nested Lists while process interchange loads a
    # compact Matrix. Use the dedicated predicate: `dim` is Matrix-only and
    # row indexing is List-only, so neither operation is a universal probe.
    let width = if is_matrix(full) {
        let shape = dim(full)
        if len(shape) > 1 { shape[1] } else { 0 }
    } else {
        if len(full) > 0 { len(full[0]) } else { 0 }
    }
    # Narrowing here is legitimate -- a caller may hold fewer components than
    # the default asks for -- but it must not be invisible. An HBC run asked for
    # 40 dimensions, received 30, and reported 40 in its summary and every log
    # line; the clusters, markers and UMAP were all computed on 30. The count
    # actually used is already recorded below as `neighbor_dims`; a report that
    # prints a constant instead of reading it is the thing that lies.
    let dims = range(0, if n_dims < width { n_dims } else { width })
    let embed = if len(dims) > 0 { select_cols(full, dims) } else { full }
    let graph = if snn { snn_graph(embed, k) } else { knn_graph(embed, k) }
    let graphs = if contains(keys(prepared), "graphs") { prepared.graphs } else { ({}) }
    let named_graphs = if snn { {... graphs, snn: graph} } else { {... graphs, nn: graph} }
    {... prepared,
        knn: graph, n_neighbors: k, neighbor_dims: len(dims),
        graphs: named_graphs
    }
}

## cluster(obj, k) → Record
##
## k-means on the same embedding `neighbors` uses. When k is 0 (the default) it
## is chosen from the cell count: 2 / 5 / 10 / 20 for <=20, <=100, <=400, and
## larger objects. That is a placeholder, not an estimate — pass k explicitly,
## or prefer cluster_leiden, which discovers the count from the graph.
##
## Adds obj.clusters (List<Int>) and obj.cluster_inertia (Float).
fn cluster(obj, k = 0) {
    let prepared = if contains(keys(obj), "pca_scores") { obj } else { run_pca(obj) }
    let embed = embedding_of(prepared)
    let n_c   = len(embed)
    let k_act = if k > 0 then k
                else if n_c > 400 then 20
                else if n_c > 100 then 10
                else if n_c > 20  then 5
                else 2
    let result = kmeans(embed, k_act)
    {... prepared, clusters: result.clusters, cluster_inertia: result.inertia}
}

## cluster_leiden(obj, k, resolution) → Record
##
## Community-detection clustering with the real Leiden algorithm (local moving
## + refinement + aggregation) on a symmetric kNN graph of the HVG embedding.
## Unlike `cluster` (k-means), the number of clusters is discovered from the
## data and every community is guaranteed internally connected.
## Adds obj.clusters (List<Int>).
fn cluster_leiden(obj, k = 15, resolution = 1.0) {
    let prepared = if contains(keys(obj), "knn") { obj } else { neighbors(obj, k) }
    let clusters = leiden_graph(prepared.knn, prepared.n_cells, resolution)
    {... prepared, clusters: clusters, resolution: resolution}
}

## cluster_louvain(obj, k, resolution) → Record
##
## Community detection with Louvain — local moving and aggregation, without
## Leiden's refinement pass. Adds obj.clusters (List<Int>).
##
## This is what you want when comparing against Seurat, whose `FindClusters`
## defaults to `algorithm = 1`, which is Louvain. `cluster_leiden` is the better
## algorithm — refinement is what guarantees every community is internally
## connected, which Louvain does not — but "better" and "what the reference ran"
## are different questions, and reproducing a published number needs the second.
##
## Runs from 10 randomised node orders and keeps the highest modularity, which
## is `FindClusters(n.start = 10)`. A single greedy pass lands in whichever
## local optimum the node order leads to; running it longer does not help,
## running it again from a different order does.
fn cluster_louvain(obj, k = 20, resolution = 0.8) {
    let prepared = if contains(keys(obj), "knn") { obj } else { neighbors(obj, k) }
    let clusters = louvain_graph(prepared.knn, prepared.n_cells, resolution)
    {... prepared, clusters: clusters, resolution: resolution}
}

## Compute and store a UMAP reduction with the defaults used by Seurat 5.5.1.
fn run_umap(obj, n_dims = 10, n_neighbors = 30, min_dist = 0.3, seed = 42) {
    let prepared = if contains(keys(obj), "pca_scores") { obj } else { run_pca(obj) }
    let full = embedding_of(prepared)
    let width = if is_matrix(full) {
        let shape = dim(full)
        if len(shape) > 1 { shape[1] } else { 0 }
    } else {
        if len(full) > 0 { len(full[0]) } else { 0 }
    }
    let dims = range(0, if n_dims < width { n_dims } else { width })
    let input = if len(dims) > 0 { select_cols(full, dims) } else { full }
    let embedding = sc_umap(input, {
        n_components: 2,
        n_neighbors: n_neighbors,
        n_epochs: if prepared.n_cells <= 10000 { 500 } else { 200 },
        min_dist: min_dist,
        metric: "cosine",
        seed: seed,
        spread: 1.0,
        negative_sample_rate: 5
    })
    let reductions = if contains(keys(prepared), "reductions") { prepared.reductions } else { ({}) }
    {... prepared,
        umap: embedding,
        reductions: {... reductions, umap: {
            embeddings: embedding, key: "UMAP_", n_neighbors: n_neighbors,
            min_dist: min_dist, metric: "cosine", seed: seed
        }}
    }
}
