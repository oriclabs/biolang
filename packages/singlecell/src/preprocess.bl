# singlecell/src/preprocess.bl — QC, normalization, and embedding
#
# Wraps core singlecell builtins for the common Seurat-style workflow:
#   filter_cells → normalize → variable_genes → scale → neighbors → cluster

## qc(obj) → Record
##
## Compute per-cell and per-gene QC metrics, adding them to obj.
##   obj.cell_qc_table — Table{cell_idx, total_counts, n_genes, pct_mito}
##   obj.gene_qc_table — Table{gene_idx, n_cells, mean_expression, pct_dropout}
fn qc(obj) {
    let cqc = cell_qc(obj.matrix, obj.genes)
    let gqc = gene_qc(obj.matrix, obj.genes)
    {... obj, cell_qc_table: cqc, gene_qc_table: gqc}
}

## filter_cells(obj, min_genes, max_genes, max_pct_mito) → Record
##
## Keep cells with gene counts in [min_genes, max_genes] and
## mitochondrial fraction ≤ max_pct_mito.
## Computes QC metrics on demand (does not require qc() to be called first).
fn filter_cells(obj, min_genes = 200, max_genes = 5000, max_pct_mito = 25.0) {
    let n   = obj.n_cells
    let n_g = obj.n_genes

    # Identify mitochondrial gene indices (names starting with "MT-")
    let mito_idx = range(0, n_g) |> filter(|j| {
        let g = obj.genes[j]
        let gstr = str(g)
        len(gstr) >= 3 and substr(gstr, 0, 3) == "MT-"
    })

    let keep_idx = range(0, n) |> filter(|i| {
        let row        = obj.matrix[i]
        let total      = sum(row)
        let n_detected = row |> filter(|v| v > 0.0) |> len()
        let mito_sum   = mito_idx |> map(|j| row[j]) |> sum()
        let pct_mito   = if total > 0.0 then mito_sum / total * 100.0 else 0.0
        n_detected >= min_genes and n_detected <= max_genes and pct_mito <= max_pct_mito
    })

    let new_mat = keep_idx |> map(|i| obj.matrix[i])
    let new_bc  = keep_idx |> map(|i| obj.barcodes[i])
    {... obj, matrix: new_mat, barcodes: new_bc, n_cells: len(new_mat)}
}

## filter_genes(obj, min_cells) → Record
##
## Keep genes expressed in at least min_cells cells.
fn filter_genes(obj, min_cells = 3) {
    let n   = obj.n_cells
    let n_g = obj.n_genes

    let keep_gene_idx = range(0, n_g) |> filter(|j| {
        let n_expr = obj.matrix |> filter(|row| row[j] > 0.0) |> len()
        n_expr >= min_cells
    })

    let new_genes  = keep_gene_idx |> map(|j| obj.genes[j])
    let new_matrix = obj.matrix |> map(|row| keep_gene_idx |> map(|j| row[j]))

    {... obj,
        matrix:  new_matrix,
        genes:   new_genes,
        n_genes: len(new_genes)
    }
}

## normalize(obj, target) → Record
##
## Library-size normalisation (counts per target) followed by log1p.
## Adds obj.norm_matrix (cells × genes).
fn normalize(obj, target = 10000.0) {
    let norm = normalize_total(obj.matrix, target) |> log1p_transform()
    {... obj, norm_matrix: norm}
}

## sctransform(obj) → Record
##
## Regularised negative-binomial regression (Pearson residuals),
## clipped at ±sqrt(n_cells). Adds obj.norm_matrix.
fn sctransform(obj) {
    let residuals = sc_sctransform(obj.matrix)
    {... obj, norm_matrix: residuals}
}

## variable_genes(obj, n) → Record
##
## Select the top n highly variable genes by coefficient of variation.
## Adds obj.hvg (List<Int>), obj.hvg_matrix (cells × HVGs),
## and obj.hvg_genes (List<Str>).
fn variable_genes(obj, n = 2000) {
    let mat = obj.norm_matrix
    let hvg_idx  = highly_variable_genes(mat, n)
    let hvg_mat  = select_cols(mat, hvg_idx)
    let hvg_g    = hvg_idx |> map(|j| obj.genes[j])
    {... obj, hvg: hvg_idx, hvg_matrix: hvg_mat, hvg_genes: hvg_g}
}

## scale(obj) → Record
##
## Per-gene mean-centering and unit-variance scaling.
## Operates on norm_matrix if present, otherwise raw matrix.
## Adds obj.scaled_matrix (cells × genes).
fn scale(obj) {
    let mat = obj.norm_matrix
    let n_c = len(mat)
    let n_g = if n_c > 0 then len(mat[0]) else 0

    let gene_means = range(0, n_g) |> map(|j|
        mean(range(0, n_c) |> map(|i| mat[i][j]))
    )
    let gene_stds = range(0, n_g) |> map(|j| {
        let m  = gene_means[j]
        let sq = range(0, n_c) |> map(|i| (mat[i][j] - m) ** 2.0)
        sqrt(mean(sq) + 1e-8)
    })

    let scaled = mat |> map(|row|
        range(0, n_g) |> map(|j| (row[j] - gene_means[j]) / gene_stds[j])
    )
    {... obj, scaled_matrix: scaled}
}

## neighbors(obj, k) → Record
##
## Build a k-nearest-neighbour graph on the HVG matrix (or norm_matrix).
## Adds obj.knn (List<Record{source, target, distance}>).
fn neighbors(obj, k = 15) {
    let embed = obj.hvg_matrix
    let knn   = knn_graph(embed, k)
    {... obj, knn: knn}
}

## cluster(obj, k) → Record
##
## k-means clustering on the HVG embedding. k defaults to sqrt(n_cells).
## Adds obj.clusters (List<Int>) and obj.cluster_inertia (Float).
fn cluster(obj, k = 0) {
    let embed = obj.hvg_matrix
    let n_c   = len(embed)
    let k_act = if k > 0 then k
                else if n_c > 400 then 20
                else if n_c > 100 then 10
                else if n_c > 20  then 5
                else 2
    let result = kmeans(embed, k_act)
    {... obj, clusters: result.clusters, cluster_inertia: result.inertia}
}

## cluster_leiden(obj, k, resolution) → Record
##
## Community-detection clustering with the real Leiden algorithm (local moving
## + refinement + aggregation) on a symmetric kNN graph of the HVG embedding.
## Unlike `cluster` (k-means), the number of clusters is discovered from the
## data and every community is guaranteed internally connected.
## Adds obj.clusters (List<Int>).
fn cluster_leiden(obj, k = 15, resolution = 1.0) {
    let embed = obj.hvg_matrix
    let clusters = leiden_cluster(embed, k, resolution)
    {... obj, clusters: clusters}
}
