# singlecell/src/integration.bl — Multi-sample batch correction
#
# Wraps sc_integrate for simplified batch correction (centering by batch).
# For stronger integration, use the harmony or fastMNN approaches
# (requires running sc_sctransform first, then sc_integrate).

import "singlecell/src/preprocess" as _pre

## integrate(obj, batch_ids) → Record
##
## Correct batch effects in PCA space by centering every batch on the
## global component means. This is a deterministic baseline for exploratory
## integration; use Harmony or fastMNN for complex batch structure.
##
## batch_ids — List<Int>, one batch label per cell (same length as n_cells).
##
## Adds obj.integrated_embedding (cells x components) and obj.batch_ids.
fn integrate(obj, batch_ids) {
    let prepared = if contains(keys(obj), "pca_scores") { obj } else { _pre.run_pca(obj) }
    let corrected = sc_integrate(prepared.pca_scores, batch_ids)
    {... prepared, integrated_embedding: corrected, batch_ids: batch_ids}
}

## harmony(obj, batch_ids) → Record
##
## Harmony (Korsunsky et al. 2019): soft-cluster the cells with a penalty that
## rewards clusters containing a mixture of batches, then regress the batch out
## within each cluster. Correcting per cluster is the point — a batch can shift
## T cells one way and monocytes another, and one global offset cannot remove
## both.
##
## `integrate` above is a single global per-batch centering. It is a reasonable
## baseline and it is not Harmony; the builtin has existed for a while but the
## package never surfaced it, so anyone following the docs got the weaker method
## while believing otherwise.
##
## Adds obj.integrated_embedding and obj.batch_ids.
fn harmony(obj, batch_ids, theta = nil, n_clusters = nil) {
    let prepared = if contains(keys(obj), "pca_scores") { obj } else { _pre.run_pca(obj) }
    let opts = {theta: _or(theta, 2.0), n_clusters: _or(n_clusters, 0)}
    let corrected = if opts.n_clusters > 0 {
        harmony_integrate(prepared.pca_scores, batch_ids,
                          {theta: opts.theta, n_clusters: opts.n_clusters})
    } else {
        harmony_integrate(prepared.pca_scores, batch_ids, {theta: opts.theta})
    }
    {... prepared, integrated_embedding: corrected, batch_ids: batch_ids}
}

fn _or(v, d) { if v == nil { d } else { v } }

## integrate_from_column(obj, batch_col) → Record
##
## Convenience wrapper when batch metadata is stored as a list in the object.
## batch_col — name of a top-level field on obj holding List<Int> batch labels,
## e.g. obj.batch_ids after a merge. This is not an `obs` column; for those,
## pass col(obj.obs, name) to integrate() directly.
fn integrate_from_column(obj, batch_col) {
    let batch_ids = obj[batch_col]
    integrate(obj, batch_ids)
}

## merge(obj_a, obj_b, batch_a, batch_b) → Record
##
## Merge two single-cell objects and assign batch labels.
## Both objects must have the same genes (same n_genes and same gene order).
## Returns a new merged object with obj.batch_ids set.
fn merge(obj_a, obj_b, batch_a = 0, batch_b = 1) {
    sc_merge_objects(obj_a, obj_b, batch_a, batch_b)
}
