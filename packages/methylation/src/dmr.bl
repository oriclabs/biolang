import "statistics" as stat

# Differentially methylated region calling.

fn find(beta_matrix, group_a, group_b, min_delta=0.2, min_cpgs=3) {
  dmr_find(beta_matrix, group_a, group_b, min_delta, min_cpgs)
}

fn diff_cpgs(beta_matrix, group_a, group_b) {
  differential_methylation(beta_matrix, group_a, group_b)
}

fn significant_cpgs(diff_result, min_delta=0.2, padj=0.05) {
  let adj = stat.bh(diff_result.p_value)
  diff_result
    |> zip(adj)
    |> filter(fn(r, a) -> abs(r.delta_beta) >= min_delta & a <= padj)
    |> map(fn(r, _) -> r)
}
