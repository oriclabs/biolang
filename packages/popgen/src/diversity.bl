fn pi(geno_matrix)               { nucleotide_diversity(geno_matrix) }
fn tajima(n_seg, n_seq, len)     { tajima_d(n_seg, n_seq, len) }
fn afs(geno_matrix)              { allele_freq_spectrum(geno_matrix) }

fn watterson_theta(n_seg, n_sequences) {
  let a1 = range(1, n_sequences) |> map(fn(i) -> 1.0 / i) |> sum
  n_seg / a1
}
