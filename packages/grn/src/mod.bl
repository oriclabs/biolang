# grn — Gene regulatory network inference for BioLang
#
# SCENIC-lite pipeline:
#   1. Build co-expression network: correlate TF genes vs all genes
#   2. Define regulons: top correlated target genes per TF
#   3. Score per-cell TF activity: mean target expression per cell
#
# Quick start:
#   import "grn" as grn
#   import "singlecell" as sc
#
#   let obj = sc.load("data/10x/") |> sc.normalize |> sc.cluster
#   let tf_indices = [42, 156, 312, 445, 891]    # row indices of TF genes
#   let network  = grn.coexpression(obj, tf_indices)
#   let regulons = tf_indices |> map(fn(tf) -> {
#       tf_idx: tf,
#       target_indices: grn.top_targets(network, tf, 50).target_idx
#     })
#   let obj = grn.score_activity(obj, regulons)
#   grn.top_tfs_per_cluster(obj)

import "grn/src/coexpr"   as coexpr
import "grn/src/activity"  as activity

fn coexpression(obj, tf_indices, min_corr = 0.3) {
  coexpr.coexpression_network(obj, tf_indices, min_corr)
}
fn top_targets(network, tf_idx, n = 20) { coexpr.top_targets(network, tf_idx, n) }
fn score_activity(obj, regulons)        { activity.score_tf_activity(obj, regulons) }
fn top_tfs_per_cluster(obj, n = 5)      { activity.top_tfs_per_cluster(obj, n) }
