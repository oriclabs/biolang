import "singlecell" as sc
import "velocity"   as vel

# Load spliced/unspliced count matrices from separate MEX directories
let spliced   = read_10x("data/spliced/")
let unspliced = read_10x("data/unspliced/")

# Build and cluster a singlecell object from the spliced counts
let obj = sc.from_matrix(spliced.matrix, spliced.genes, spliced.barcodes)
  |> sc.filter_cells
  |> sc.normalize
  |> sc.variable_genes(2000)
  |> sc.neighbors
  |> sc.cluster

# Attach unspliced and run velocity
let obj = obj |> set_field("spliced",   spliced.matrix)
              |> set_field("unspliced", unspliced.matrix)

let obj = vel.estimate(obj) |> vel.project
vel.get_arrows(obj)
