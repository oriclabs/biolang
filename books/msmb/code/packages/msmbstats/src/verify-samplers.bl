import "msmbstats/src/multinomial"

# The two samplers must agree in distribution. Compare their mean counts over
# many draws against the expectation, which is size * p.
let probs = [0.4, 0.3, 0.2, 0.1]
let size = 50
let reps = 400

set_seed(5)
let slow = range(0, reps) |> map(|_| rmultinom_slow(size, probs))
set_seed(5)
let fast = range(0, reps) |> map(|_| rmultinom_one(size, probs))

fn column_mean(draws, i) {
    draws |> map(|d| d[i]) |> mean()
}

println("box   expected   slow     fast")
range(0, 4) |> each(|i| {
    println(f"{i}     {probs[i] * size:>6.1f}   {column_mean(slow, i):>6.2f}   {column_mean(fast, i):>6.2f}")
})

println("")
println("every draw sums to size:")
println(f"  slow: {slow |> map(|d| sum(d)) |> filter(|s| s != size) |> len()} bad of {reps}")
println(f"  fast: {fast |> map(|d| sum(d)) |> filter(|s| s != size) |> len()} bad of {reps}")

println("")
let t0 = 0
let big = rmultinom_one(10482, [0.25, 0.25, 0.25, 0.25])
println(f"fast sampler at size 10482: {big}  (sums to {sum(big)})")
