# Continuous distributions BioLang does not ship.
#
# BioLang has rnorm, rpois and rbinom. Chapter 4 needs the gamma family too,
# because the negative binomial - the workhorse distribution for sequencing
# counts - is built from it.
#
# Writing rnbinom out is not busywork here. The construction *is* the chapter's
# argument: a negative binomial is a Poisson whose rate is itself random, and
# implementing it that way makes overdispersion something you build rather than
# something you are told about.

# --- exponential ---------------------------------------------------------

# Inverse-transform sampling. If U is uniform on [0,1) then -ln(1-U)/rate has
# the exponential distribution, because that is the inverse of its CDF.
# 1 - U rather than U so that U = 0 does not produce log(0).
fn rexp_one(rate) {
    -1.0 * log(1.0 - random()) / rate
}

fn rexp(n, rate) {
    range(0, n) |> map(|_| rexp_one(rate))
}

# --- gamma ---------------------------------------------------------------

# Marsaglia-Tsang (2000), the standard rejection sampler.
#
# Draw a normal, square it into a candidate, and accept with a probability that
# corrects the shape. Rejection sampling needs an unbounded loop, so this uses
# `while` with a generous cap rather than recursion - the interpreter's stack
# allows only a few hundred nested calls.
fn rgamma_one(shape, scale) {
    if shape < 1.0 {
        # Boost into the shape >= 1 regime and correct: if X ~ Gamma(a+1) and
        # U ~ Uniform, then X * U^(1/a) ~ Gamma(a).
        let boosted = rgamma_one(shape + 1.0, 1.0)
        return boosted * pow(random(), 1.0 / shape) * scale
    }

    let d = shape - 1.0 / 3.0
    let c = 1.0 / sqrt(9.0 * d)
    let result = 0.0
    let done = false
    let attempts = 0

    while done == false && attempts < 1000 {
        attempts = attempts + 1
        let x = rnorm(1, 0.0, 1.0)[0]
        let v = pow(1.0 + c * x, 3)
        if v > 0.0 {
            let u = random()
            # The acceptance test, in logs.
            if log(u) < 0.5 * x * x + d - d * v + d * log(v) {
                result = d * v * scale
                done = true
            }
        }
    }
    result
}

fn rgamma(n, shape, scale) {
    range(0, n) |> map(|_| rgamma_one(shape, scale))
}

# --- negative binomial ---------------------------------------------------

# A Poisson whose rate varies from draw to draw.
#
# Parameterised by mean `mu` and dispersion `size` (R's `size`/`mu` form, and
# the one DESeq2 and edgeR use). Larger size means less extra variability;
# as size goes to infinity this becomes an ordinary Poisson.
#
#   variance = mu + mu^2 / size
#
# The second term is the overdispersion, and it is what makes this distribution
# necessary for RNA-seq counts, where biological replicates vary far more than
# Poisson counting noise allows.
fn rnbinom_one(size, mu) {
    # Gamma with mean mu and shape `size`, then Poisson with that rate.
    let rate = rgamma_one(size, mu / size)
    rpois(1, rate)[0]
}

fn rnbinom(n, size, mu) {
    range(0, n) |> map(|_| rnbinom_one(size, mu))
}

# Probability mass, via the gamma-Poisson mixture written in closed form.
# Computed in logs: the factorials overflow quickly otherwise.
fn dnbinom(k, size, mu) {
    let ln_coefficient = ln_gamma(k + size) - ln_gamma(size) - ln_gamma(k + 1.0)
    let ln_p = size * log(size / (size + mu)) + k * log(mu / (size + mu))
    exp(ln_coefficient + ln_p)
}

# Log-gamma by the Lanczos approximation - accurate to about 15 digits, which
# is far more than any count model needs.
fn ln_gamma(x) {
    let coefficients = [
        676.5203681218851, -1259.1392167224028, 771.32342877765313,
        -176.61502916214059, 12.507343278686905, -0.13857109526572012,
        0.0000099843695780195716, 0.00000015056327351493116,
    ]
    if x < 0.5 {
        # Reflection, for arguments where the series does not converge.
        log(3.141592653589793 / sin(3.141592653589793 * x)) - ln_gamma(1.0 - x)
    } else {
        let z = x - 1.0
        let a = 0.99999999999980993
        let series = range(0, 8)
            |> map(|i| coefficients[i] / (z + i + 1.0))
            |> sum()
        let total = a + series
        let t = z + 7.5
        0.5 * log(2.0 * 3.141592653589793) + (z + 0.5) * log(t) - t + log(total)
    }
}
