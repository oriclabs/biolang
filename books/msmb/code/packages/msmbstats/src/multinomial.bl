# Multinomial distribution, written out by hand.
#
# BioLang ships dbinom/rbinom and dpois/rpois, but nothing multinomial. That is
# the distribution Chapter 1 needs most: four nucleotides, four blood-group
# alleles, any experiment where each observation lands in one of k boxes rather
# than just "success" or "failure".
#
# Writing it out is not a workaround. The multinomial is the binomial with more
# than two boxes, and seeing the two formulas side by side is most of the
# insight:
#
#   binomial      P(x) = C(n, x) p^x (1-p)^(n-x)
#   multinomial   P(x) = n! / (x1! x2! ... xk!) * p1^x1 p2^x2 ... pk^xk
#
# The leading coefficient counts the orderings that give the same tally; the
# product weights one particular ordering.

# --- sampling -----------------------------------------------------------

# Cumulative probability up to and including category `i`.
#
# Rebuilt per call rather than accumulated once. With k = 4 categories that is
# four additions and the clarity is worth more than the cycles.
fn cumulative_at(probs, i) {
    range(0, i + 1) |> map(|j| probs[j]) |> sum()
}

# Turn one uniform draw into one category.
#
# Picture the unit interval cut into k pieces, piece i as wide as probs[i]. A
# uniform point lands in piece i with probability probs[i] - which is exactly
# what a categorical draw means.
fn pick_category(u, probs) {
    let k = len(probs)
    let landed = range(0, k) |> filter(|i| u < cumulative_at(probs, i))
    # Guard the boundary: floating-point sums may stop a hair below 1.0, and a
    # draw above the last edge belongs to the last category.
    if len(landed) == 0 { k - 1 } else { landed[0] }
}

# One multinomial draw, the obvious way: `size` categorical picks, tallied.
#
# Clear, and far too slow past a few thousand observations - it does one
# interpreted loop iteration per observation. Kept because it is the definition,
# and because rmultinom_one below is only believable if you can check it against
# something this plain.
fn rmultinom_slow(size, probs) {
    let draws = range(0, size) |> map(|_| pick_category(random(), probs))
    range(0, len(probs)) |> map(|i| draws |> count_if(|d| d == i))
}

# One multinomial draw, the practical way: a chain of binomials.
#
# The trick is worth understanding, because it is the multinomial-binomial
# relationship made concrete. Ask "how many A?" - that is just binomial, A
# against everything-else. Having answered it, the remaining bases are spread
# over C, G, T alone, so ask "how many C, out of what is left?" - binomial
# again, with p rescaled to the shrunken pool. Repeat. The last box takes
# whatever remains.
#
# k binomial draws instead of `size` categorical ones, and rbinom is native.
fn rmultinom_one(size, probs) {
    let k = len(probs)
    let start = { left: size, pool: 1.0, counts: [] }
    let done = range(0, k) |> reduce(|acc, i| {
        if i == k - 1 {
            # Last box: no choice left to make.
            { left: 0, pool: 0.0, counts: concat(acc.counts, [acc.left]) }
        } else {
            # Rescale this box's probability to the pool still unassigned.
            # Clamped because repeated subtraction can drift a hair past 1.
            let share = if acc.pool <= 0.0 { 0.0 } else { min(probs[i] / acc.pool, 1.0) }
            let x = if acc.left <= 0 { 0 } else { rbinom(1, acc.left, share)[0] }
            {
                left: acc.left - x,
                pool: acc.pool - probs[i],
                counts: concat(acc.counts, [x]),
            }
        }
    }, start)
    done.counts
}

# `n` independent draws, each a list of k counts summing to `size`.
fn rmultinom(n, size, probs) {
    range(0, n) |> map(|_| rmultinom_one(size, probs))
}

# --- density ------------------------------------------------------------

# Exact probability of the tally `x` under `probs`.
#
# factorial() overflows well before size 30, so this is only for the small
# hand-checkable cases. The simulations below never need it.
fn dmultinom(x, probs) {
    let size = sum(x)
    let denom = x |> map(|xi| factorial(xi)) |> reduce(|a, b| a * b, 1)
    let coefficient = factorial(size) / denom
    let weight = range(0, len(x))
        |> map(|i| pow(probs[i], x[i]))
        |> reduce(|a, b| a * b, 1.0)
    coefficient * weight
}

# --- goodness of fit ----------------------------------------------------

# The chi-square-like distance between what we saw and what we expected.
#
# Each term is a squared error scaled by its expected size, which is what stops
# a box expected to hold 1000 from drowning out a box expected to hold 5.
fn chi_stat(observed, expected) {
    range(0, len(observed))
        |> map(|i| pow(observed[i] - expected[i], 2) / expected[i])
        |> sum()
}

# Expected counts when `size` observations are spread over `probs`.
fn expected_counts(size, probs) {
    probs |> map(|p| p * size)
}
