# 2.5 Estimating an allele frequency: Hardy-Weinberg
#
# Adapted from "Modern Statistics for Modern Biology", Holmes & Huber,
# Chapter 2. See ../../book/src/attribution.md.
#
# Run:  bl run 05-hardy-weinberg.bl

# The MN blood group has two alleles, M and N, so three genotypes: MM, MN, NN.
# Blood typing sees the genotype directly, which is unusual and convenient.
#
# Data: 580 people from Tahiti (the book's Mourant dataset, row 216).

let n_mm = 188
let n_mn = 296
let n_nn = 96
let n_people = n_mm + n_mn + n_nn

println("== The data ==")
println(f"  MM: {n_mm}")
println(f"  MN: {n_mn}")
println(f"  NN: {n_nn}")
println(f"  total individuals: {n_people}")
println("")

# --- Two levels of counting -----------------------------------------------

println("== Individuals carry two alleles each ==")
println("")
println("This is the step that trips people up. We observe 580 *people*, but")
println("the parameter is about *alleles*, and there are twice as many:")
println("")

let n_alleles = 2 * n_people
let m_alleles = 2 * n_mm + n_mn
let n_alleles_n = 2 * n_nn + n_mn

println(f"  M alleles: 2 x {n_mm} (from MM) + {n_mn} (one from each MN) = {m_alleles}")
println(f"  N alleles: 2 x {n_nn} (from NN) + {n_mn} (one from each MN) = {n_alleles_n}")
println(f"  total alleles: {n_alleles}")
println("")

# --- The model ------------------------------------------------------------

println("== The Hardy-Weinberg model ==")
println("")
println("If individuals pair at random with respect to this gene, a genotype is")
println("just two independent draws from the allele pool. With p the frequency")
println("of M and q = 1 - p:")
println("")
println("    P(MM) = p^2      P(MN) = 2pq      P(NN) = q^2")
println("")
println("The 2 in the middle term is there because MN and NM are the same")
println("genotype - the same reason a binomial coefficient appears in Chapter 1.")
println("")

# --- Maximum likelihood ---------------------------------------------------

# Log-likelihood of the genotype counts under Hardy-Weinberg.
fn loglikelihood(p) {
    let q = 1.0 - p
    2.0 * n_mm * log(p) + n_mn * log(2.0 * p * q) + 2.0 * n_nn * log(q)
}

println("== Finding p by maximum likelihood ==")
println("      p     log-likelihood")

let grid = range(1, 99) |> map(|i| i * 0.01)
let curve = grid |> map(|p| loglikelihood(p))

[0.40, 0.50, 0.55, 0.58, 0.60, 0.70] |> each(|p| {
    println(f"  {p:>5.2f}    {loglikelihood(p):>10.3f}")
})
println("")

let best = grid[argmax(curve)]
println(f"grid maximum at p = {best:.2f}")
println("")

# --- The shortcut ---------------------------------------------------------

println("== And the answer you could have written down ==")
let phat = m_alleles * 1.0 / n_alleles
println(f"  M alleles / total alleles = {m_alleles} / {n_alleles} = {phat:.7f}")
println("")
println("Same value. As with the Poisson in section 2.1, maximum likelihood")
println("recovers the obvious estimator - here, just counting alleles. Useful")
println("as reassurance that the machinery is not inventing anything, and as a")
println("check that the code is right.")
println("")

# --- Does the model fit? --------------------------------------------------

println("== Testing the model, not the parameter ==")
println("")
println("Estimating p assumed Hardy-Weinberg held. That assumption is worth")
println("checking on its own, because the interesting biology is in its")
println("failures.")
println("")

let qhat = 1.0 - phat
let expected = [
    phat * phat * n_people,
    2.0 * phat * qhat * n_people,
    qhat * qhat * n_people,
]
let observed = [n_mm, n_mn, n_nn]

println("  genotype   observed   expected")
println(f"  MM         {observed[0]:>8}   {expected[0]:>8.4f}")
println(f"  MN         {observed[1]:>8}   {expected[1]:>8.4f}")
println(f"  NN         {observed[2]:>8}   {expected[2]:>8.4f}")
println("")

fn chi_stat(obs, exp) {
    range(0, len(obs)) |> map(|i| pow(obs[i] - exp[i], 2) / exp[i]) |> sum()
}

let stat = chi_stat(observed, expected)
println(f"distance from the model: {stat:.4f}")
println("")

# Calibrate by simulating populations that genuinely follow Hardy-Weinberg at
# this p and this sample size.
fn simulate_hw() {
    let mm = rbinom(1, n_people, phat * phat)[0]
    let mn = rbinom(1, n_people - mm, (2.0 * phat * qhat) / (1.0 - phat * phat))[0]
    chi_stat([mm, mn, n_people - mm - mn], expected)
}

set_seed(216)
let null_stats = range(0, 10000) |> map(|_| simulate_hw())
let as_extreme = null_stats |> count_if(|s| s >= stat)

println(f"10000 populations simulated under Hardy-Weinberg at p = {phat:.4f}")
println(f"  median distance: {quantile(null_stats, 0.5):.3f}")
println(f"  95th percentile: {quantile(null_stats, 0.95):.3f}")
println(f"  at least as far as observed: {as_extreme} of 10000")
println(f"  p-value: {as_extreme * 1.0 / 10000:.4f}")
println("")

println("== Reading the result ==")
println("The observed counts sit comfortably inside what random mating")
println("produces. Hardy-Weinberg is not rejected for this population.")
println("")
println("Which is the useful outcome to be able to recognise, because the model")
println("failing is what signals something worth investigating: population")
println("structure, inbreeding, selection at the locus, or - most often in")
println("practice - a genotyping error.")

# --- PUBLISHED FIGURES ------------------------------------------------------
#
# The book quotes these numbers. If a change to BioLang moves one, this script
# fails loudly rather than letting the prose quietly go stale.

assert abs(phat - 0.5793103) < 0.0000001, "allele frequency moved; book publishes 0.5793103"
assert abs(expected[0] - 194.6483) < 0.001, "expected MM moved; book publishes 194.6483"
assert abs(expected[1] - 282.7034) < 0.001, "expected MN moved; book publishes 282.7034"
assert abs(expected[2] - 102.6483) < 0.001, "expected NN moved; book publishes 102.6483"
