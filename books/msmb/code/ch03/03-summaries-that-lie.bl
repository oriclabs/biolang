# 3.3 Why plot at all? Four datasets that agree on everything but the picture
#
# Companion to Chapter 3 of "Modern Statistics for Modern Biology",
# Holmes & Huber. See ../../book/src/attribution.md.
#
# The quartet below is Anscombe's (1973), not from MSMB - included because it
# is the shortest complete argument for the chapter's thesis.
#
# Run:  bl run 03-summaries-that-lie.bl

# figures/ is gitignored, so it does not exist in a fresh clone.
mkdir("figures")

# Everything so far has been about making plots better. This is about why you
# make them at all, when a table of summary statistics is so much more compact.

let x_common = [10.0, 8.0, 13.0, 9.0, 11.0, 14.0, 6.0, 4.0, 12.0, 7.0, 5.0]

let sets = [
    { name: "I",   x: x_common,
      y: [8.04, 6.95, 7.58, 8.81, 8.33, 9.96, 7.24, 4.26, 10.84, 4.82, 5.68] },
    { name: "II",  x: x_common,
      y: [9.14, 8.14, 8.74, 8.77, 9.26, 8.10, 6.13, 3.10, 9.13, 7.26, 4.74] },
    { name: "III", x: x_common,
      y: [7.46, 6.77, 12.74, 7.11, 7.81, 8.84, 6.08, 5.39, 8.15, 6.42, 5.73] },
    { name: "IV",  x: [8.0, 8.0, 8.0, 8.0, 8.0, 8.0, 8.0, 19.0, 8.0, 8.0, 8.0],
      y: [6.58, 5.76, 7.71, 8.84, 8.47, 7.04, 5.25, 12.50, 5.56, 7.91, 6.89] },
]

# --- The table you would put in a paper -----------------------------------

println("== Four datasets, summarised ==")
println("")
println("  set   n   mean x   mean y    sd x    sd y      r    slope  intercept")

sets |> each(|s| {
    let r = cor(s.x, s.y)
    # Least squares through the means.
    let slope = r * stdev(s.y) / stdev(s.x)
    let intercept = mean(s.y) - slope * mean(s.x)
    println(f"  {s.name:<4} {len(s.x):>2}   {mean(s.x):>6.2f}  {mean(s.y):>6.2f}  {stdev(s.x):>6.3f}  {stdev(s.y):>6.3f}  {r:>5.3f}   {slope:>5.3f}     {intercept:>5.3f}")
})

println("")
println("Every column agrees to two or three decimals. Same centre, same spread,")
println("same correlation, same fitted line. Any test you ran on one would give")
println("essentially the answer it gave on the others.")
println("")
println("On this evidence the four datasets are interchangeable.")
println("")

# --- The pictures ---------------------------------------------------------

println("== The same four datasets, drawn ==")
println("")

fn ascii_scatter(xs, ys, label) {
    let width = 36
    let height = 13
    let xlo = 2.0
    let xhi = 20.0
    let ylo = 2.0
    let yhi = 13.5

    # Mark the cell each point falls in, then print row by row.
    let marks = range(0, len(xs)) |> map(|i| {
        let c = min(round((xs[i] - xlo) / (xhi - xlo) * (width - 1)), width - 1)
        let r = min(round((ys[i] - ylo) / (yhi - ylo) * (height - 1)), height - 1)
        f"{r}:{c}"
    })
    let filled = frequencies(marks)

    println(f"  dataset {label}")
    range(0, height) |> each(|rr| {
        let row = height - 1 - rr
        let line = range(0, width)
            |> map(|c| if has_key(filled, f"{row}:{c}") { "o" } else { " " })
            |> join("")
        println(f"  |{line}|")
    })
    println(f"  +{str_repeat(\"-\", width)}+")
}

sets |> each(|s| {
    ascii_scatter(s.x, s.y, s.name)
    println("")
})

println("== What each one actually is ==")
println("")
println("  I    a genuine linear relationship with scatter. The summary is honest.")
println("")
println("  II   a clean curve. The relationship is perfect and not linear; fitting")
println("       a line to it discards the real structure and reports r = 0.816 as")
println("       though the fit were mediocre rather than wrong.")
println("")
println("  III  a tight straight line plus one outlier. The line is dragged off")
println("       the other ten points by a single observation.")
println("")
println("  IV   ten points at one x value, and one point far away. The 'slope' is")
println("       determined entirely by that one point - remove it and the slope")
println("       is undefined. r = 0.816 describes a relationship that does not")
println("       exist.")
println("")

println("== The point ==")
println("")
println("Summary statistics compress, and compression discards. Mean and standard")
println("deviation are the right summary only when the data is the shape those")
println("two numbers assume - roughly symmetric, one lump, no outliers. When it")
println("is not, they do not warn you; they just quietly answer a different")
println("question.")
println("")
println("Plotting is not presentation. It is the check that the summary you are")
println("about to publish means what you think it means, and it costs one line.")
println("")

# --- Save the real figures -------------------------------------------------

sets |> each(|s| {
    let t = table(range(0, len(s.x)) |> map(|i| { x: s.x[i], y: s.y[i] }))
    save_svg(plot(t, { title: f"Anscombe {s.name}", xlabel: "x", ylabel: "y", kind: "scatter" }),
             f"figures/anscombe-{s.name}.svg")
})
println("== Wrote figures/anscombe-I.svg through anscombe-IV.svg ==")
