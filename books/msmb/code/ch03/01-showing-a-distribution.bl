# 3.1 Showing one distribution, and the choices that change what you see
#
# Adapted from "Modern Statistics for Modern Biology", Holmes & Huber,
# Chapter 3. See ../../book/src/attribution.md.
#
# Run:  bl run 01-showing-a-distribution.bl
# Writes SVGs into figures/.

# figures/ is gitignored, so it does not exist in a fresh clone.
mkdir("figures")

# A plot is an argument, and like any argument it can be made badly without
# anyone noticing. This chapter is about the choices that are invisible in the
# finished figure but decide what it says.
#
# We use generated data throughout, because then the truth is known. Here: gene
# expression from two cell populations - one low, one high, in a 70/30 mix.
# Anyone looking at the data should be able to discover that there are two.

set_seed(3)
let low = rnorm(700, 4.0, 0.8)
let high = rnorm(300, 7.5, 0.9)
let expression = concat(low, high)

println("== The data ==")
println(f"  {len(expression)} cells, from two populations we mixed ourselves")
println(f"  mean {mean(expression):.3f}, sd {stdev(expression):.3f}")
println("")

# --- The summary that hides everything ------------------------------------

println("== First: the numbers alone ==")
println(f"  min     {min(expression):.2f}")
println(f"  Q1      {quantile(expression, 0.25):.2f}")
println(f"  median  {quantile(expression, 0.5):.2f}")
println(f"  Q3      {quantile(expression, 0.75):.2f}")
println(f"  max     {max(expression):.2f}")
println("")
println("Five numbers, and not one of them says 'two populations'. They cannot;")
println("quantiles describe position, not shape.")
println("")

println("== A boxplot draws exactly those five numbers ==")
boxplot(expression)
println("")
println("So the boxplot inherits the blind spot. It is a fine tool for comparing")
println("many groups' locations at a glance, and a bad one for asking whether a")
println("single distribution has the shape you assume.")
println("")

# --- The histogram, and the choice nobody mentions -------------------------

println("== A histogram shows shape - but which one? ==")
println("")
println("Bin count is a free parameter, and it is not cosmetic.")
println("")

println("--- 5 bins: one lump, structure erased ---")
println(hist(expression, 5))
println("--- 25 bins: two populations, obvious ---")
println(hist(expression, 25))
println("--- 120 bins: noise, structure buried again ---")
println(hist(expression, 120))

println("")
println("Same data, three stories: unimodal, bimodal, and static. Too few bins")
println("smooths real features away; too many turns sampling noise into apparent")
println("features. Nothing in the figure warns you which you are looking at.")
println("")
println("The practical rule: never trust one binning. Vary it and keep only the")
println("features that survive.")
println("")

# --- The plot with no free parameters --------------------------------------

println("== The ECDF: no binning choice at all ==")
println("")
println("The empirical cumulative distribution plots, for each value x, the")
println("fraction of the data at or below x. Every observation is drawn; nothing")
println("is grouped, so there is nothing to tune.")
println("")

let sorted_values = sort(expression)
let n = len(sorted_values)

# The ECDF at a handful of points, by hand.
fn ecdf_at(x) {
    (sorted_values |> count_if(|v| v <= x)) * 1.0 / n
}

println("     x     fraction at or below")
[3.0, 4.0, 5.0, 6.0, 7.0, 8.0, 9.0] |> each(|x| {
    let f = ecdf_at(x)
    println(f"  {x:>4.1f}     {f:.3f}  {str_repeat(\"#\", round(f * 40))}")
})
println("")
println("Read the slope, not the height. Steep means many observations packed")
println("together; flat means a gap. The flat stretch around x = 6 is the space")
println("between the two populations - visible without choosing anything.")
println("")

# --- Save the real figures -------------------------------------------------

let svg_few = histogram(expression, { title: "5 bins - one population?", bins: 5 })
let svg_good = histogram(expression, { title: "25 bins - two populations", bins: 25 })
let svg_many = histogram(expression, { title: "120 bins - noise", bins: 120 })

save_svg(svg_few, "figures/hist-5-bins.svg")
save_svg(svg_good, "figures/hist-25-bins.svg")
save_svg(svg_many, "figures/hist-120-bins.svg")

println("== Wrote figures/hist-5-bins.svg, hist-25-bins.svg, hist-120-bins.svg ==")
println("Open them side by side. The differences are the point.")
