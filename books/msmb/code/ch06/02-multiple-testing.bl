# 6.2 Twenty thousand tests at once
#
# Adapted from "Modern Statistics for Modern Biology", Holmes & Huber,
# Chapter 6. See ../../book/src/attribution.md.
#
# Run:  bl run 02-multiple-testing.bl

# A 5% false positive rate is fine for one test. Genomics does not run one test.
# It runs one per gene, and the arithmetic that was reassuring becomes alarming.

let n_genes = 10000
let n_per_group = 10

println("== An experiment where nothing is differentially expressed ==")
println(f"  {n_genes} genes, {n_per_group} samples per group, no real differences at all")
println("")

set_seed(60)
let p_values = range(0, n_genes) |> map(|_| {
    ttest(rnorm(n_per_group, 0.0, 1.0), rnorm(n_per_group, 0.0, 1.0)).p_value
})

let naive = p_values |> count_if(|p| p < 0.05)
println(f"  genes with p < 0.05: {naive}")
println("")
println(f"Five per cent of {n_genes} is {n_genes / 20}, and that is what we got.")
println("Every one is a false positive - we generated the data with no effects.")
println("Publish that list and it is 500 genes, a pathway analysis, and a story.")
println("")

println("== The p-values are uniform, as they must be ==")
println(hist(p_values, 10))

# --- Bonferroni ------------------------------------------------------------

println("== Bonferroni: control the chance of ANY false positive ==")
let bonf = p_adjust(p_values, "bonferroni")
println(f"  significant after Bonferroni: {bonf |> count_if(|p| p < 0.05)}")
println("")
println("Zero, which is correct - there is nothing to find. Bonferroni multiplies")
println("every p-value by the number of tests, so it controls the probability of")
println("making even one mistake across the whole experiment.")
println("")
println("That is a strict guarantee, and it costs power. Below, the same")
println("correction applied to an experiment that does contain real effects.")
println("")

# --- With real effects ------------------------------------------------------

set_seed(61)
let n_true = 300
let with_effects = range(0, n_genes) |> map(|i| {
    let shift = if i < n_true { 2.0 } else { 0.0 }
    ttest(rnorm(n_per_group, 0.0, 1.0), rnorm(n_per_group, shift, 1.0)).p_value
})

println(f"== Now {n_true} of the {n_genes} genes are genuinely changed ==")
println("")

fn report(label, adjusted, cutoff) {
    let called = range(0, n_genes) |> filter(|i| adjusted[i] < cutoff)
    let true_positives = called |> count_if(|i| i < n_true)
    let false_positives = len(called) - true_positives
    let fdr = if len(called) == 0 { 0.0 } else { false_positives * 1.0 / len(called) }
    println(f"  {label:<26} called {len(called):>4}   real {true_positives:>4}   false {false_positives:>4}   false share {fdr * 100.0:>5.1f}%   found {true_positives * 100.0 / n_true:>5.1f}% of truth")
}

report("uncorrected p < 0.05", with_effects, 0.05)
report("Bonferroni", p_adjust(with_effects, "bonferroni"), 0.05)
report("Benjamini-Hochberg (FDR)", p_adjust(with_effects, "fdr"), 0.05)
println("")

println("== Reading that table ==")
println("")
println("Uncorrected finds the most real genes and drags in hundreds of false")
println("ones. Roughly two in three of its calls are wrong, which makes the list")
println("useless as a list even though it contains most of the truth.")
println("")
println("Bonferroni buys near-certainty that nothing on its list is spurious,")
println("and pays by missing most of the real genes. For a screen whose output")
println("is a single confirmatory experiment, that trade is often right.")
println("")
println("Benjamini-Hochberg controls a different quantity: not the chance of any")
println("error, but the expected PROPORTION of errors among the genes you call.")
println("Setting it at 5% says 'about one in twenty of my hits will be wrong,")
println("and I accept that'. For a screen feeding into further work, that is")
println("usually the honest bargain - and it recovers far more of the truth.")
println("")
println("Look at what it actually delivered: of the genes it called, 5.0% were")
println("false. That is not a coincidence or a lucky seed - it is the quantity")
println("the method controls, hitting its nominal level. Bonferroni delivered")
println("0% false at the cost of finding one gene in twelve.")
println("")

println("== The choice is about consequences, not statistics ==")
println("  Bonferroni  ->  is ANY of this wrong?      (one follow-up experiment)")
println("  BH / FDR    ->  what FRACTION is wrong?    (a candidate list)")
println("")
println("Neither is a default. Choosing before you look at the data is what")
println("keeps the answer honest.")
