# 13.1 Design: the decisions that analysis cannot undo
#
# Adapted from "Modern Statistics for Modern Biology", Holmes & Huber,
# Chapter 13. See ../../book/src/attribution.md.
#
# Run:  bl run 01-design.bl

# Everything up to here analysed data that already existed. This chapter is
# about the choices made before any data exists - and they matter more, because
# no analysis can repair a design that threw the information away.

# --- Confounding -----------------------------------------------------------

println("== Confounding: the failure no method can fix ==")
println("")
println("A study runs all treated samples on Monday and all controls on Tuesday.")
println("Sequencing runs differ - reagents, machine drift, whoever was on shift.")
println("So each measurement carries a treatment effect and a day effect, added")
println("together, and nothing in the data says which is which.")
println("")

set_seed(130)
let n = 8
let treatment_effect = 1.0
let batch_effect = 2.5

# Confounded: treated is always Monday, control always Tuesday.
let confounded_treated = range(0, n) |> map(|_| rnorm(1, 10.0 + treatment_effect + batch_effect, 1.0)[0])
let confounded_control = range(0, n) |> map(|_| rnorm(1, 10.0, 1.0)[0])

println(f"  true treatment effect: {treatment_effect}")
println(f"  true batch effect:     {batch_effect}")
println(f"  measured difference:   {mean(confounded_treated) - mean(confounded_control):.3f}")
println(f"  p-value:               {ttest(confounded_control, confounded_treated).p_value:.6f}")
println("")
println("Highly significant, and the estimate is roughly 3.5 - the sum of the")
println("two effects. The test is not wrong; it faithfully reports that Monday")
println("samples differ from Tuesday samples. It was simply never asked about")
println("treatment, because the experiment made the two questions the same one.")
println("")

# --- The fix is in the design, not the analysis ----------------------------

println("== The same experiment, blocked ==")
println("")
println("Run half of each group on each day. Now the batch effect applies to")
println("both groups equally, and the treatment difference survives it.")
println("")

set_seed(131)
let blocked = range(0, n) |> map(|i| {
    let day = if i < n / 2 { batch_effect } else { 0.0 }
    {
        treated: rnorm(1, 10.0 + treatment_effect + day, 1.0)[0],
        control: rnorm(1, 10.0 + day, 1.0)[0],
    }
})

let bt = blocked |> map(|b| b.treated)
let bc = blocked |> map(|b| b.control)

println(f"  measured difference:   {mean(bt) - mean(bc):.3f}   (true value {treatment_effect})")
println(f"  p-value:               {ttest(bc, bt).p_value:.6f}")
println("")
println("The estimate now lands on the real effect. The batch effect is still")
println("there and still large - it just no longer masquerades as treatment,")
println("because it moves both groups together.")
println("")
println("Better still, pairing the samples removes it from the comparison")
println("entirely:")
let paired = ttest_paired(bc, bt)
println(f"  paired p-value:        {paired.p_value:.8f}")
println("")
println("Same data, a sharper test, because the design licensed it. That is the")
println("general shape of this chapter: design decisions buy statistical power")
println("that no amount of later cleverness can recover.")
println("")

# --- Replication ------------------------------------------------------------

println("== What counts as a replicate ==")
println("")
println("Two mice, each sequenced four times, is not eight replicates. The four")
println("runs from one mouse share everything that makes that mouse itself.")
println("")

set_seed(132)
let mice = 2
let runs_each = 4
let mouse_sd = 1.5
let run_sd = 0.2

fn pseudo_experiment() {
    let a = range(0, mice) |> flat_map(|_| {
        let animal = rnorm(1, 10.0, mouse_sd)[0]
        range(0, runs_each) |> map(|_| animal + rnorm(1, 0.0, run_sd)[0])
    })
    let b = range(0, mice) |> flat_map(|_| {
        let animal = rnorm(1, 10.0, mouse_sd)[0]
        range(0, runs_each) |> map(|_| animal + rnorm(1, 0.0, run_sd)[0])
    })
    ttest(a, b).p_value
}

let pseudo_fp = range(0, 800) |> count_if(|_| pseudo_experiment() < 0.05)
println(f"  800 experiments with NO real difference between groups")
println(f"  treating {mice * runs_each} runs as {mice * runs_each} replicates: significant {pseudo_fp * 100.0 / 800.0:.1f}% of the time")
println("")
println("Nominally 5%. The technical runs are nearly identical to each other, so")
println("the test sees a tiny standard error and concludes the two groups differ")
println("whenever the two mice happened to differ - which is most of the time.")
println("")

let honest_fp = range(0, 800) |> count_if(|_| {
    let a = range(0, mice) |> map(|_| rnorm(1, 10.0, mouse_sd)[0])
    let b = range(0, mice) |> map(|_| rnorm(1, 10.0, mouse_sd)[0])
    ttest(a, b).p_value < 0.05
})
println(f"  averaging each mouse first ({mice} v {mice}): significant {honest_fp * 100.0 / 800.0:.1f}% of the time")
println("")
println("Correct, and appropriately underpowered - which is the honest report of")
println("an experiment with two animals per group. Technical replicates improve")
println("the measurement of each animal; they say nothing about animals in")
println("general, and the unit of replication has to match the unit you want to")
println("generalise to.")
println("")

# --- Planning ---------------------------------------------------------------

println("== Deciding the size before running it ==")
println("")
println("power_t_test(effect, alpha, power) answers the question you can still")
println("act on: how many samples do I need?")
println("")
println("  effect (sd)   power 0.80   power 0.90")
[0.3, 0.5, 0.8, 1.0, 1.5] |> each(|d| {
    println(f"  {d:>11.1f}   {power_t_test(d, 0.05, 0.80).n:>10}   {power_t_test(d, 0.05, 0.90).n:>10}")
})
println("")
println("Read it backwards from the power you need. To detect a half-standard-")
println("deviation effect with the conventional 80% power takes 63 samples")
println("per group; most published experiments of that size have far fewer.")
println("")
println("This calculation costs nothing and can only be done beforehand. Run the")
println("experiment first and the same arithmetic becomes a post-hoc power")
println("analysis, which answers a question nobody asked and is not evidence of")
println("anything.")
