# 1.3 Why the Poisson shows up everywhere
#
# Adapted from "Modern Statistics for Modern Biology", Holmes & Huber,
# Chapter 1. See ../../book/src/attribution.md.
#
# Run:  bl run 03-binomial-to-poisson.bl

# The Poisson is not a separate idea from the binomial. It is what the binomial
# becomes when there are a great many chances and each one is very unlikely -
# which describes almost every counting problem in molecular biology. A genome
# has 10^4 sites; each mutates with probability 10^-4; the count of mutations
# is binomial, but nobody wants to work with C(10000, k).
#
# The rule: when n is large and p is small, B(n, p) is Poisson(n*p).

let n = 10000
let p = 0.0005
let lambda = n * p

println(f"n = {n}, p = {p}, so lambda = n*p = {lambda}")
println("")

println("== The two distributions, side by side ==")
println("  k   binomial   Poisson    difference")

range(0, 13) |> each(|k| {
    let b = dbinom(k, n, p)
    let q = dpois(k, lambda)
    println(f"{k:>3}   {b:.6f}   {q:.6f}   {abs(b - q):.8f}")
})

# The two columns agree to about five decimal places. The Poisson has one
# parameter where the binomial has two, and needs no factorials of 10000.

println("")
println("== Confirming by simulation ==")

# Draw whole binomial experiments and tally how often each count appears. This
# is the crank-turning a generative model is for: no formula, just repetition.
let trials = 20000
set_seed(2024)
let simulated = rbinom(trials, n, p)

println(f"{trials} simulated experiments of {n} trials each")
println("")
println("  k   simulated   Poisson expectation")

let tallies = frequencies(simulated)

range(0, 13) |> each(|k| {
    let seen = if has_key(tallies, str(k)) { tallies[str(k)] } else { 0 }
    let fraction = seen * 1.0 / trials
    let expected = dpois(k, lambda)
    println(f"{k:>3}   {fraction:.5f}     {expected:.5f}")
})

println("")
println(f"mean of the simulated counts: {mean(simulated):.4f}   (lambda = {lambda})")

# The simulated fractions wobble around the Poisson probabilities by about the
# amount you would expect from 20000 draws. That wobble is not error - it is
# the sampling variability that every real experiment also has, and estimating
# its size is what the rest of this chapter is about.
