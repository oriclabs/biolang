# 1.1 Counting rare events: the Poisson distribution
#
# Adapted from "Modern Statistics for Modern Biology", Holmes & Huber,
# Chapter 1. See ../../book/src/attribution.md.
#
# Run:  bl run 01-poisson.bl

# A generative model is a claim about the machinery that produced your data.
# Not a summary of the data - a mechanism that, if you turned the crank, would
# produce data like it. Once you have one, "is this result surprising?" becomes
# a question you can answer by turning the crank and looking.
#
# The Poisson is the model for counting rare events over many opportunities.
# One number controls it: lambda, the average count.

println("== Probability of exactly 3 mutations when the average is 5 ==")
println(dpois(3, 5))

# Read that as: if the true mutation rate averages 5 per genome, about 14% of
# genomes carry exactly 3. Not "3 is the answer" - a probability for every count.

println("")
println("== The whole distribution, Poisson(5) ==")
println("  k    P(X = k)")

let lambda = 5
let counts = range(0, 13)

counts |> each(|k| {
    let p = dpois(k, lambda)
    # A bar 200 characters wide per unit of probability keeps the tallest bar
    # near 35 columns, which fits a terminal without wrapping.
    let bar = str_repeat("#", round(p * 200))
    println(f"{k:>3}  {p:.4f}  {bar}")
})

# Two things to notice, and they are the whole reason this distribution is
# useful for biology:
#
#   1. The peak sits at the average, 5, but 4 is just as likely. The mode of a
#      Poisson is not a sharp answer, it is a broad shoulder.
#   2. The tail does not stop. Twelve mutations has probability 0.0034 - small,
#      but not zero. Nothing here forbids a large count; it just makes it rare.
#
# That second point is what makes the Poisson a *null* model. If you see 12,
# you cannot say "impossible". You can say "this happens 3 times in a thousand
# if my model is right", and then decide whether to keep believing the model.

println("")
println("== The probabilities sum to (nearly) 1 ==")
let total = counts |> map(|k| dpois(k, lambda)) |> sum()
println(f"sum over k = 0..12: {total:.6f}")
println("The shortfall is the tail beyond 12 that we did not draw.")

println("")
println("== Computing it the long way ==")
# The formula is lambda^k * e^-lambda / k!. Worth doing once by hand so the
# builtin stops being a black box.
let by_hand = pow(5.0, 3) * exp(-5.0) / factorial(3)
println(f"by hand: {by_hand:.10f}")
println(f"dpois:   {dpois(3, 5):.10f}")
