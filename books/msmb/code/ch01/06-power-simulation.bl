# 1.6 Could we even have detected it? Simulating power
#
# Adapted from "Modern Statistics for Modern Biology", Holmes & Huber,
# Chapter 1. See ../../book/src/attribution.md.
#
# Run:  bl run 06-power-simulation.bl

import "msmbstats/src/multinomial"

# Everything so far asked: if the fair model is true, how surprised should I be?
# That fixes the false-alarm rate. It says nothing about the other failure -
# the model being wrong and the experiment missing it.
#
# Power is the probability of noticing, when there really is something to
# notice. You cannot measure it from your data. You simulate it, and you do it
# *before* running the experiment, while the sample size is still a choice.

let size = 20
let uniform = [0.25, 0.25, 0.25, 0.25]
let expected = expected_counts(size, uniform)

# --- Step 1: the threshold, from the null model ---------------------------

set_seed(42)
let null_stats = rmultinom(1000, size, uniform) |> map(|d| chi_stat(d, expected))
let q95 = quantile(null_stats, 0.95)

println("== Step 1: where to draw the line ==")
println(f"1000 fair draws of {size} bases")
println(f"95th percentile of the distance: {q95:.3f}")
println("Call anything above that 'not fair'. By construction we will be wrong")
println("5% of the time when the sequence really is fair.")
println("")

# --- Step 2: the alternative we care about --------------------------------

# A specific departure from uniform. Power is never a single number for a test;
# it is a number for a test *against a stated alternative*. Ask "what is the
# power?" and the honest answer is "to detect what, exactly?"
let skewed = [3.0 / 8.0, 1.0 / 4.0, 1.0 / 4.0, 1.0 / 8.0]

println("== Step 2: the departure we want to catch ==")
println(f"fair:   {uniform}")
println(f"skewed: {skewed}")
println(f"expected counts under skew: {expected_counts(size, skewed)}")
println("")

# --- Step 3: run the experiment many times, under the alternative ---------

set_seed(11)
let alt_draws = rmultinom(1000, size, skewed)

# Note the expectation used here is still the *fair* one. That is the whole
# logic of the test: we always measure distance from the null, and ask how
# often data from the alternative lands far enough away.
let alt_stats = alt_draws |> map(|d| chi_stat(d, expected))

let detected = alt_stats |> count_if(|s| s > q95)
let power = detected * 1.0 / len(alt_stats)

println("== Step 3: how often would we notice? ==")
println(f"first three skewed draws: {alt_draws[0]}, {alt_draws[1]}, {alt_draws[2]}")
println(f"their distances: {chi_stat(alt_draws[0], expected):.2f}, {chi_stat(alt_draws[1], expected):.2f}, {chi_stat(alt_draws[2], expected):.2f}")
println("")
println(f"exceeded the threshold: {detected} of {len(alt_stats)}")
println(f"POWER = {power:.3f}")
println("")
println(f"So with {size} bases we would miss this skew about {(1.0 - power) * 100.0:.0f}% of the time.")
println("Four experiments in five come back negative even though the skew is")
println("real and sizeable. A negative result here is not 'no effect' - it is")
println("'no information'.")
println("")

# --- Step 4: the fix is sample size ---------------------------------------

println("== Step 4: how many observations would be enough? ==")
println("  n      power")

[20, 50, 100, 200, 400, 1000] |> each(|n| {
    let exp_n = expected_counts(n, uniform)
    set_seed(7)
    let null_n = rmultinom(600, n, uniform) |> map(|d| chi_stat(d, exp_n))
    let cut = quantile(null_n, 0.95)
    set_seed(8)
    let alt_n = rmultinom(600, n, skewed) |> map(|d| chi_stat(d, exp_n))
    let pw = (alt_n |> count_if(|s| s > cut)) * 1.0 / 600.0
    println(f"  {n:>4}   {pw:.3f}")
})

println("")
println("Power climbs with sample size, and the threshold moves too - both are")
println("recomputed at every n above, which is why this has to be simulated")
println("rather than read off a single curve.")
println("")
println("The practical lesson: a negative result from an underpowered design")
println("tells you nothing, and you can find that out beforehand, for free.")

# --- PUBLISHED FIGURES ------------------------------------------------------
#
# The book quotes these numbers. If a change to BioLang moves one, this script
# fails loudly rather than letting the prose quietly go stale.

assert abs(q95 - 7.6) < 0.6, f"95th percentile is {q95}, book publishes 7.6"
assert abs(power - 0.199) < 0.05, f"power is {power}, book publishes 0.199"
