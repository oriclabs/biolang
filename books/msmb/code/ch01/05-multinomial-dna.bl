# 1.5 More than two outcomes: nucleotides and the multinomial
#
# Adapted from "Modern Statistics for Modern Biology", Holmes & Huber,
# Chapter 1. See ../../book/src/attribution.md.
#
# Run:  bl run 05-multinomial-dna.bl

import "msmbstats/src/multinomial"

# A binomial counts successes against failures. DNA has four outcomes, blood
# groups have four alleles, a die has six. The multinomial is the same idea
# with k boxes instead of 2.

println("== The smallest example ==")
let uniform = [0.25, 0.25, 0.25, 0.25]
println(f"P(4 A's, 2 C's, 0 G's, 0 T's in 6 bases, all equally likely)")
println(f"  = {dmultinom([4, 2, 0, 0], uniform):.10f}")
println("")
println("Small, and it should be: that is one specific tally out of many, and")
println("a run of 4 A's in 6 bases is a lopsided outcome for a fair process.")
println("")

println("== Drawing sequences from the model ==")
set_seed(7)
println(f"one draw of 8 bases:  {rmultinom_one(8, uniform)}   (as A, C, G, T)")
println(f"another:              {rmultinom_one(8, uniform)}")
println(f"another:              {rmultinom_one(8, uniform)}")
println("")
println("Same model, different answers. None of them is 2,2,2,2 - which is the")
println("point. Even a perfectly uniform process almost never gives you flat")
println("counts, and mistaking that wobble for signal is the classic error.")
println("")

# --- Measuring the wobble -------------------------------------------------

println("== How far from flat should we expect to be? ==")

# We need a single number for "how unlike the expectation is this tally". The
# standard choice sums squared errors, each divided by what was expected there:
#
#     sum over boxes of  (observed - expected)^2 / expected
#
# Dividing by the expected count is what makes boxes comparable. Being 5 off
# matters much more when you expected 5 than when you expected 5000.

let size = 20
let expected = expected_counts(size, uniform)
println(f"20 bases over 4 equally likely nucleotides -> expect {expected}")
println("")

set_seed(42)
let null_draws = rmultinom(1000, size, uniform)

println("first three draws and their distance from flat:")
range(0, 3) |> each(|i| {
    let d = null_draws[i]
    println(f"  {d}  ->  {chi_stat(d, expected):.3f}")
})
println("")

let null_stats = null_draws |> map(|d| chi_stat(d, expected))

println("== The sampling distribution of that distance ==")
println(f"  mean:    {mean(null_stats):.3f}")
println(f"  median:  {quantile(null_stats, 0.5):.3f}")
println(f"  90th %:  {quantile(null_stats, 0.90):.3f}")
println(f"  95th %:  {quantile(null_stats, 0.95):.3f}")
println(f"  max:     {max(null_stats):.3f}")
println("")

let q95 = quantile(null_stats, 0.95)
println(f"So under a fair model, the distance exceeds {q95:.2f} only 5% of the")
println("time. That number is a threshold we derived from the model itself -")
println("no table, no formula, just simulation.")
println("")

println("== Histogram of the distance under the fair model ==")
println(hist(null_stats, 15))

# --- Applying it to real-ish sequence -------------------------------------

println("")
println("== Testing a sequence for equal base composition ==")

# Base counts of the Caenorhabditis elegans mitochondrial chromosome, the
# example the book uses. Hard-coded so this runs without a genome package or a
# network call; regenerate them from any FASTA with base_counts().
# Strikingly AT-rich, as mitochondrial genomes tend to be.
let observed = [4335, 1225, 2055, 6179]
let n = sum(observed)
let flat = expected_counts(n, uniform)

println(f"observed A, C, G, T: {observed}")
println(f"total bases: {n}")
println(f"expected if equal:   {flat}")
println("")

let distance = chi_stat(observed, flat)
println(f"distance from flat: {distance:.1f}")
println("")

# Calibrate against the same model, at this sample size.
set_seed(3)
let calibration = rmultinom(300, n, uniform) |> map(|d| chi_stat(d, flat))
println(f"under a fair model at n = {n}, that distance runs:")
println(f"  median {quantile(calibration, 0.5):.1f}, 95th percentile {quantile(calibration, 0.95):.1f}, max seen {max(calibration):.1f}")
println("")
println(f"Observed {distance:.0f} against a maximum of {max(calibration):.0f} in 300 simulations.")
println("The four bases are not equally likely in this sequence, and it is not close.")

# --- PUBLISHED FIGURES ------------------------------------------------------
#
# The book quotes these numbers. If a change to BioLang moves one, this script
# fails loudly rather than letting the prose quietly go stale.

assert abs(dmultinom([4, 2, 0, 0], uniform) - 0.003662109375) < 0.0000000001,
    "dmultinom moved; book publishes 0.003662109"
assert abs(distance - 4386.634) < 0.5,
    f"C. elegans goodness of fit is {distance}, book publishes 4386.634"
