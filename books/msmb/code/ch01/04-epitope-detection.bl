# 1.4 Is that a signal, or did we just look in a lot of places?
#
# Adapted from "Modern Statistics for Modern Biology", Holmes & Huber,
# Chapter 1. See ../../book/src/attribution.md.
#
# Run:  bl run 04-epitope-detection.bl
#
# Data: generated here with set_seed so the script runs offline. The book's
# original e100 is in its data bundle; see ../../book/src/data.md.

# The setup. An ELISA array tests 100 positions along a protein for antibody
# binding. The assay is imperfect: even with no real binding, each position
# occasionally lights up. Calibration says the false-positive rate averages
# 0.5 hits per position - so Poisson(0.5) is the noise model.
#
# We run the array and one position shows 7 hits. Real epitope, or noise?

let positions = 100
let background = 0.5

set_seed(8969311)
let noise = rpois(positions, background)

# Position 42 is the candidate epitope: 7 hits where the background predicts
# well under one.
let observed = range(0, positions) |> map(|i| if i == 42 { 7 } else { noise[i] })

println("== The array ==")
println(f"positions: {positions}")
println(f"counts seen: {frequencies(observed)}")
println(f"largest count: {max(observed)} at position 42")
println("")

# --- The tempting mistake -----------------------------------------------

println("== First attempt: how surprising is 7 at one position? ==")

# ppois(6, 0.5) is P(at most 6). One minus that is P(7 or more).
let tail = 1.0 - ppois(6, background)
println(f"P(a given position shows 7 or more) = {tail:.10f}")
println("")
println("About one in a million. Case closed?")
println("")

# --- Why that is wrong ---------------------------------------------------

println("== The catch ==")
println("We did not ask about *a given position*. We scanned 100 of them and")
println("then pointed at the largest. The question that matches what we did is:")
println("")
println("   how often does the LARGEST of 100 background counts reach 7?")
println("")

# --- Answering it by simulation -----------------------------------------

println("== Monte Carlo: turn the crank and look ==")

# Simulate the whole experiment under the assumption that nothing is real:
# 100 positions of pure background. Record only the maximum, because the
# maximum is what we actually reacted to.
let runs = 100000
set_seed(1)
let maxima = range(0, runs) |> map(|_| max(rpois(positions, background)))

println(f"{runs} simulated arrays, each of {positions} background positions")
println(f"distribution of the maximum: {frequencies(maxima)}")
println("")

let at_least_7 = maxima |> count_if(|m| m >= 7)
let p_value = at_least_7 * 1.0 / runs
println(f"arrays whose maximum reached 7: {at_least_7} of {runs}")
println(f"simulated p-value: {p_value:.6f}")
println("")

# --- The closed form ------------------------------------------------------

println("== The same answer without simulating ==")

# P(at least one of n positions reaches m)
#   = 1 - P(all n stay below m)
#   = 1 - (1 - epsilon)^n,  where epsilon = P(one position reaches m)
# and for small epsilon, (1 - epsilon)^n is close to exp(-n * epsilon).
fn poismax(lambda, n, m) {
    let epsilon = 1.0 - ppois(m - 1, lambda)
    1.0 - exp(-1.0 * n * epsilon)
}

println(f"poismax(0.5, 100, 7) = {poismax(0.5, positions, 7):.6f}")
println(f"simulation gave        {p_value:.6f}")
println("")

# --- What changes the answer ---------------------------------------------

println("== The background rate matters enormously ==")
println("  lambda   P(max of 100 reaches 7)")
[0.5, 1.0, 1.5, 2.0] |> each(|l| {
    println(f"  {l:>4}     {poismax(l, positions, 7):.6f}")
})
println("")
println("At lambda = 0.5 a 7 is remarkable. At lambda = 2.0 it is routine.")
println("Everything depends on having the noise model right - which is a")
println("statement about the assay, not about the statistics.")
println("")

println("== And how high the peak is ==")
println("  m    P(max of 100 reaches m)")
[5, 6, 7, 8, 9] |> each(|m| {
    println(f"  {m}    {poismax(background, positions, m):.8f}")
})

# --- PUBLISHED FIGURES ------------------------------------------------------
#
# The book quotes these numbers. If a change to BioLang moves one, this script
# fails loudly rather than letting the prose quietly go stale.

assert abs(poismax(0.5, 100, 7) - 0.0001002329) < 0.0000001,
    "poismax moved; book publishes 0.0001002329"
assert abs(tail - 0.0000010024) < 0.0000000001,
    "single-position tail moved; book publishes 1.00e-06"
