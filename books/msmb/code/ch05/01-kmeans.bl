# 5.1 k-means, and the question it cannot answer
#
# Adapted from "Modern Statistics for Modern Biology", Holmes & Huber,
# Chapter 5. See ../../book/src/attribution.md.
#
# Run:  bl run 01-kmeans.bl

# Clustering asks: are there groups in this data, and which points belong to
# which? Note what is absent - no labels, no training set, no right answer to
# check against. That absence is the whole difficulty, and it is why clustering
# produces confident output on data with no structure whatsoever.

# Three genuine groups, so we can check the answer.
set_seed(5)
let centres = [[2.0, 2.0], [8.0, 3.0], [5.0, 9.0]]
let per_group = 60

let points = range(0, 3) |> flat_map(|g| {
    range(0, per_group) |> map(|_| [
        centres[g][0] + rnorm(1, 0.0, 1.0)[0],
        centres[g][1] + rnorm(1, 0.0, 1.0)[0],
    ])
})
let truth = range(0, 3) |> flat_map(|g| range(0, per_group) |> map(|_| g))

println("== The data ==")
println(f"  {len(points)} points, {len(centres)} genuine groups")
println("")

fn show(pts, labels, title) {
    let width = 46
    let height = 16
    let symbols = ["o", "x", "+", "*", "#"]
    let xs = pts |> map(|p| p[0])
    let ys = pts |> map(|p| p[1])
    let xlo = min(xs)
    let xhi = max(xs)
    let ylo = min(ys)
    let yhi = max(ys)
    let cells = range(0, len(pts)) |> map(|i| {
        let c = min(round((pts[i][0] - xlo) / (xhi - xlo) * (width - 1)), width - 1)
        let r = min(round((pts[i][1] - ylo) / (yhi - ylo) * (height - 1)), height - 1)
        f"{r}:{c}"
    })
    # BioLang has no way to insert a dynamic key into a map, so the lookup is a
    # scan. At this grid size that is cheap and keeps the code obvious.
    println(f"  {title}")
    range(0, height) |> each(|rr| {
        let row = height - 1 - rr
        let line = range(0, width) |> map(|c| {
            let key = f"{row}:{c}"
            let hit = find_index(cells, |k| k == key)
            if hit >= 0 { symbols[labels[hit] % 5] } else { " " }
        }) |> join("")
        println(f"  |{line}|")
    })
}

show(points, truth, "the truth")
println("")

# --- Running k-means ------------------------------------------------------

println("== k-means with k = 3 ==")
let flat = points |> map(|p| [p[0], p[1]])
let result = kmeans(flat, 3)
println(f"  returned: {keys(result)}")
show(points, result.clusters, "k-means, k = 3")
println("")

# How well did it do? Clustering labels are arbitrary - cluster 0 here may be
# group 2 there - so count agreement on *pairs* instead: do two points that
# belong together end up together?
fn pair_agreement(a, b) {
    let n = len(a)
    let agree = 0
    let total = 0
    range(0, n) |> each(|i| {
        range(i + 1, n) |> each(|j| {
            total = total + 1
            let same_true = a[i] == a[j]
            let same_found = b[i] == b[j]
            if same_true == same_found { agree = agree + 1 }
        })
    })
    agree * 1.0 / total
}

println(f"  pairs classified consistently with the truth: {pair_agreement(truth, result.clusters) * 100.0:.1f}%")
println("")
println("Labels are arbitrary, so agreement is measured on pairs: do two points")
println("that belong together end up together? That is invariant to relabelling.")
println("")

# --- The part that should worry you ---------------------------------------

println("== k-means always answers ==")
println("")
println("Give it structureless data and it still returns clusters, with the same")
println("confident output format:")
println("")

set_seed(8)
let noise = range(0, 180) |> map(|_| [rnorm(1, 5.0, 2.5)[0], rnorm(1, 5.0, 2.5)[0]])
let noise_result = kmeans(noise, 3)
show(noise, noise_result.clusters, "k-means on one uniform blob, k = 3")
println("")
println("Three tidy wedges, none of them real. k-means partitions; it does not")
println("test whether a partition is warranted. Nothing in its output says 'this")
println("data has no groups', because it has no way to say that.")
println("")

# --- Choosing k -----------------------------------------------------------

println("== And it cannot tell you k ==")
println("")
println("  k    within-cluster sum of squares")
range(1, 8) |> each(|k| {
    let r = kmeans(flat, k)
    println(f"  {k}    {r.inertia:>12.2f}")
})
println("")
println("The score falls at every k and reaches zero when k equals the number of")
println("points - each point its own cluster, a perfect and useless fit. You")
println("cannot choose k by minimising it.")
println("")
println("The usual advice is to look for the elbow, where the improvement drops")
println("off. Above, the fall from 2 to 3 is large and from 3 to 4 much smaller,")
println("which points at 3 - correct here. On real data the elbow is often not")
println("obvious, and reading one into an ambiguous curve is how clustering")
println("results become unreproducible.")
