# 5.2 Hierarchical clustering, written out
#
# Adapted from "Modern Statistics for Modern Biology", Holmes & Huber,
# Chapter 5. See ../../book/src/attribution.md.
#
# Run:  bl run 02-hierarchical.bl

# k-means needs to be told k before it starts. Hierarchical clustering does not:
# it builds the whole nesting, from every point separate to everything in one
# group, and you choose where to cut afterwards - or never.
#
# BioLang has no hclust, so the algorithm is written out here. It is short, and
# writing it makes the one decision that matters impossible to overlook.

let names = ["liver", "kidney", "spleen", "heart", "lung", "brain", "cerebellum", "cortex"]

# A small expression-distance matrix: three brain tissues that resemble each
# other, three abdominal organs, and heart/lung between them.
let profiles = [
    [8.1, 2.0, 1.2],   # liver
    [7.6, 2.4, 1.5],   # kidney
    [7.9, 1.8, 2.0],   # spleen
    [4.0, 6.5, 2.2],   # heart
    [3.6, 6.9, 2.6],   # lung
    [1.2, 2.1, 8.4],   # brain
    [1.5, 1.8, 8.0],   # cerebellum
    [0.9, 2.4, 8.8],   # cortex
]

fn euclidean(a, b) {
    range(0, len(a)) |> map(|i| pow(a[i] - b[i], 2)) |> sum() |> sqrt()
}

println("== Pairwise distances ==")
println("               " + (names |> map(|n| f"{substr(n, 0, 5):>6}") |> join("")))
range(0, len(names)) |> each(|i| {
    let row = range(0, len(names)) |> map(|j| f"{euclidean(profiles[i], profiles[j]):>6.1f}") |> join("")
    println(f"  {names[i]:<11}{row}")
})
println("")

# --- The algorithm --------------------------------------------------------

# Start with every point in its own cluster. Repeatedly merge the two closest
# clusters. Stop when one remains.
#
# "Closest" is the decision that matters. Two points have one distance; two
# *groups* have many, and how you summarise them is the linkage rule:
#
#   single    the closest pair between the groups
#   complete  the furthest pair
#   average   the mean over all pairs
#
# Same data, same algorithm, different trees. This is not a tuning knob to be
# left at its default.
fn cluster_distance(a, b, linkage) {
    let pairs = a |> flat_map(|i| b |> map(|j| euclidean(profiles[i], profiles[j])))
    if linkage == "single" { min(pairs) }
    else if linkage == "complete" { max(pairs) }
    else { mean(pairs) }
}

fn build_tree(linkage) {
    # Each cluster is a list of member indices, alongside the text of how it was
    # built so the merge order can be printed.
    let clusters = range(0, len(names)) |> map(|i| [i])
    let labels = names |> map(|n| n)
    let merges = []

    while len(clusters) > 1 {
        # Find the closest pair of clusters.
        let best_i = 0
        let best_j = 1
        let best_d = cluster_distance(clusters[0], clusters[1], linkage)
        range(0, len(clusters)) |> each(|i| {
            range(i + 1, len(clusters)) |> each(|j| {
                let d = cluster_distance(clusters[i], clusters[j], linkage)
                if d < best_d {
                    best_d = d
                    best_i = i
                    best_j = j
                }
            })
        })

        merges = concat(merges, [{ a: labels[best_i], b: labels[best_j], height: best_d }])

        let merged = concat(clusters[best_i], clusters[best_j])
        let merged_label = f"({labels[best_i]} {labels[best_j]})"
        clusters = concat(
            [merged],
            range(0, len(clusters)) |> filter(|k| k != best_i && k != best_j) |> map(|k| clusters[k])
        )
        labels = concat(
            [merged_label],
            range(0, len(labels)) |> filter(|k| k != best_i && k != best_j) |> map(|k| labels[k])
        )
    }
    merges
}

["single", "complete", "average"] |> each(|linkage| {
    println(f"== {linkage} linkage ==")
    let merges = build_tree(linkage)
    merges |> each(|m| {
        let bar = str_repeat("-", round(m.height * 4.0))
        println(f"  {m.height:>5.2f} {bar} {m.a} + {m.b}")
    })
    println("")
})

println("== Reading the output ==")
println("The merge heights are the distances at which groups joined. All three")
println("rules recover the same biology here - the three brain tissues join")
println("first and cheaply, the abdominal organs form their own group, and")
println("heart and lung pair up - because the groups are well separated.")
println("")
println("The heights differ though, and they differ systematically: single")
println("linkage merges at the smallest distances, complete at the largest,")
println("average in between. That is definitional, not a finding.")
println("")
println("Where the rules genuinely disagree is on data with elongated or")
println("touching groups. Single linkage will chain two clusters together")
println("through one bridging point; complete linkage refuses to merge groups")
println("with any distant pair and so breaks elongated clusters apart. Neither")
println("is wrong - they encode different ideas of what a cluster is.")
println("")

println("== Where to cut ==")
println("A dendrogram is not a clustering; it is every clustering at once. You")
println("get groups by cutting at a height, and that choice is yours:")
println("")
let avg = build_tree("average")
[0.7, 0.8, 0.9, 3.0, 7.0, 9.0] |> each(|h| {
    let groups = len(names) - (avg |> count_if(|m| m.height <= h))
    println(f"  cut at height {h:>4.1f}  ->  {groups} groups")
})
println("")
println("Notice how little the answer moves between heights 0.9 and 7.0 - every")
println("cut in that range gives three groups. That flat stretch is the useful")
println("signal: it corresponds to the large gap in the merge heights, between")
println("the last cheap merge at 0.87 and the first expensive one at 6.23.")
println("")
println("A clustering that survives a wide range of cuts is worth more than one")
println("that appears at exactly one threshold. Where the merge heights rise")
println("smoothly with no gap, no cut is defensible and the honest report is")
println("that the data does not separate - which a dendrogram will still happily")
println("draw for you.")
