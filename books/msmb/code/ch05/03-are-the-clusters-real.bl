# 5.3 Deciding whether a clustering means anything
#
# Adapted from "Modern Statistics for Modern Biology", Holmes & Huber,
# Chapter 5. See ../../book/src/attribution.md.
#
# Run:  bl run 03-are-the-clusters-real.bl

# Section 5.1 showed k-means carving three confident wedges out of a single
# structureless blob. Every clustering method does this. So the question that
# matters is not "what are the clusters" but "is there anything there".

fn euclidean(a, b) {
    range(0, len(a)) |> map(|i| pow(a[i] - b[i], 2)) |> sum() |> sqrt()
}

# --- Silhouette ------------------------------------------------------------

# For each point: how close is it to its own cluster, against the nearest
# cluster it does not belong to?
#
#   a = mean distance to the other members of its own cluster
#   b = mean distance to the members of the nearest other cluster
#   s = (b - a) / max(a, b)
#
# s near 1 means comfortably inside its own group; near 0 means on the border;
# negative means it sits closer to another cluster than its own.
fn silhouette(points, labels) {
    let k = max(labels) + 1
    range(0, len(points)) |> map(|i| {
        let own = range(0, len(points)) |> filter(|j| labels[j] == labels[i] && j != i)
        if len(own) == 0 {
            0.0
        } else {
            let a = own |> map(|j| euclidean(points[i], points[j])) |> mean()
            let others = range(0, k)
                |> filter(|c| c != labels[i])
                |> map(|c| {
                    let members = range(0, len(points)) |> filter(|j| labels[j] == c)
                    if len(members) == 0 { 1000000.0 }
                    else { members |> map(|j| euclidean(points[i], points[j])) |> mean() }
                })
            let b = min(others)
            (b - a) / max(a, b)
        }
    })
}

# --- Real structure --------------------------------------------------------

set_seed(5)
let centres = [[2.0, 2.0], [8.0, 3.0], [5.0, 9.0]]
let structured = range(0, 3) |> flat_map(|g| {
    range(0, 50) |> map(|_| [centres[g][0] + rnorm(1, 0.0, 1.0)[0],
                             centres[g][1] + rnorm(1, 0.0, 1.0)[0]])
})

# --- No structure ----------------------------------------------------------

set_seed(8)
let blob = range(0, 150) |> map(|_| [rnorm(1, 5.0, 2.5)[0], rnorm(1, 5.0, 2.5)[0]])

println("== Average silhouette width, by k ==")
println("")
println("   k    three real groups    one uniform blob")
range(2, 7) |> each(|k| {
    let s1 = mean(silhouette(structured, kmeans(structured, k).clusters))
    let s2 = mean(silhouette(blob, kmeans(blob, k).clusters))
    println(f"   {k}         {s1:>6.3f}              {s2:>6.3f}")
})
println("")
println("The structured data peaks sharply at k = 3 - the right answer - and the")
println("value is high. The blob peaks too, because something always wins, but")
println("it peaks low and flat.")
println("")
println("That contrast is the useful part. A silhouette around 0.7 says the")
println("groups are well separated. Around 0.25 says the partition is barely")
println("better than cutting the data arbitrarily, which is exactly what it is.")
println("Reporting a clustering without this number leaves out whether it means")
println("anything.")
println("")

# --- Stability -------------------------------------------------------------

println("== A second check: does the answer survive perturbation? ==")
println("")
println("Real groups should not depend on which samples you happened to collect.")
println("Drop a random fifth of the data, re-cluster, and ask whether the points")
println("that remain are grouped the same way.")
println("")

fn pair_agreement(a, b, idx) {
    let agree = 0
    let total = 0
    range(0, len(idx)) |> each(|x| {
        range(x + 1, len(idx)) |> each(|y| {
            total = total + 1
            let same_a = a[idx[x]] == a[idx[y]]
            let same_b = b[x] == b[y]
            if same_a == same_b { agree = agree + 1 }
        })
    })
    agree * 1.0 / total
}

fn stability(points, k, rounds) {
    let full = kmeans(points, k).clusters
    let scores = range(0, rounds) |> map(|_| {
        let keep = range(0, len(points)) |> filter(|_| random() < 0.8)
        let subset = keep |> map(|i| points[i])
        let sub_labels = kmeans(subset, k).clusters
        pair_agreement(full, sub_labels, keep)
    })
    mean(scores)
}

set_seed(31)
println("   k    three real groups    one uniform blob")
range(2, 6) |> each(|k| {
    println(f"   {k}         {stability(structured, k, 12):>6.3f}              {stability(blob, k, 12):>6.3f}")
})
println("")
println("Real groups reproduce perfectly - 1.000, the same pairs together every")
println("time. The blob is lower but not dramatically so, and it is worth being")
println("clear about why rather than overselling the contrast: most pairs of")
println("points sit in different clusters under any partition, and those agree")
println("trivially. That inflates the score toward 1 for any k.")
println("")
println("So stability is the weaker of the two checks as measured here, and the")
println("silhouette separated the cases far more sharply. A better measure would")
println("count only the pairs actually at risk of moving.")
println("")

println("== What to do with this ==")
println("Neither number is a p-value and neither has a threshold you can quote.")
println("They are comparisons: this clustering against what you would get from")
println("data with no groups at all.")
println("")
println("The habit worth keeping is the one from Chapter 1 in different clothes.")
println("Before believing a pattern, generate the boring version - here, data")
println("with no clusters - run the same procedure on it, and check that what")
println("you found looks different from what noise produces.")
