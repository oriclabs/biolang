# 4.1 When one distribution is really two
#
# Adapted from "Modern Statistics for Modern Biology", Holmes & Huber,
# Chapter 4. See ../../book/src/attribution.md.
#
# Run:  bl run 01-recognising-mixtures.bl

# Every model so far assumed the data came from one mechanism. Real populations
# are rarely so tidy: tissue holds several cell types, a tumour holds several
# clones, a flow cytometry run holds whatever was in the tube.
#
# A mixture says: each observation comes from one of k components, chosen with
# some probability, and you do not get told which.

# --- Building one, so we know the truth -----------------------------------

set_seed(4)
let n = 1000
let mixing = 0.35          # probability an observation comes from component 2

# Which component each observation came from. In real data this is exactly what
# is missing - and recovering it is what Section 4.2 is about.
let labels = range(0, n) |> map(|_| if random() < mixing { 1 } else { 0 })

let values = labels |> map(|z| if z == 1 { rnorm(1, 8.0, 1.0)[0] } else { rnorm(1, 4.0, 1.2)[0] })

println("== A mixture we built ourselves ==")
println(f"  component 1: mean 4.0, sd 1.2, weight {1.0 - mixing}")
println(f"  component 2: mean 8.0, sd 1.0, weight {mixing}")
println(f"  drawn from component 2: {labels |> count_if(|z| z == 1)} of {n}")
println("")

# --- The mixture is not a distribution with those parameters ---------------

println("== Why you cannot just average the components ==")
let overall_mean = mean(values)
let predicted_mean = (1.0 - mixing) * 4.0 + mixing * 8.0
println(f"  observed mean:   {overall_mean:.3f}")
println(f"  weighted mean:   {predicted_mean:.3f}    <- these do agree")
println("")
let overall_sd = stdev(values)
let within_sd = sqrt((1.0 - mixing) * 1.2 * 1.2 + mixing * 1.0 * 1.0)
println(f"  observed sd:     {overall_sd:.3f}")
println(f"  average within:  {within_sd:.3f}    <- these do NOT")
println("")
println("The mean of a mixture is the weighted mean of its components. The")
println("spread is not: the extra width comes from the gap *between* the")
println("components, which no single component contains. Fitting one normal to")
println("this data would report a standard deviation describing a population")
println("that does not exist.")
println("")

# --- Seeing it ------------------------------------------------------------

println("== The histogram ==")
println(hist(values, 30))
println("Two humps, because the components are 4 standard deviations apart.")
println("")

# --- When it stops being visible ------------------------------------------

println("== The same mixture, components moved closer ==")
[4.0, 2.5, 1.5, 0.8] |> each(|gap| {
    set_seed(9)
    let vals = range(0, n) |> map(|_| {
        if random() < mixing { rnorm(1, 4.0 + gap, 1.0)[0] } else { rnorm(1, 4.0, 1.2)[0] }
    })
    # A crude bimodality check: is there a dip between the two peaks?
    let counts = range(0, 24) |> map(|b| {
        let lo = min(vals) + b * (max(vals) - min(vals)) / 24.0
        let hi = min(vals) + (b + 1) * (max(vals) - min(vals)) / 24.0
        vals |> count_if(|v| v >= lo && v < hi)
    })
    let peak = max(counts)
    let bar = counts |> map(|c| if c > peak * 3 / 4 { "#" } else if c > peak / 4 { "+" } else { "." }) |> join("")
    println(f"  gap {gap:>4.1f} sd:  {bar}")
})
println("")
println("At a gap of 4 the two components are obvious. By 1.5 the dip is gone")
println("and the data looks like one slightly wide, slightly skewed population.")
println("")
println("The components have not merged - the data is still a mixture, and the")
println("means are still different. What has gone is your ability to see it. A")
println("mixture is not a property you can always detect; below roughly two")
println("standard deviations of separation, no amount of staring will help and")
println("you need either more data or outside knowledge of the groups.")
