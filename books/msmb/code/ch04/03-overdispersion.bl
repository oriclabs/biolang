# 4.3 Counts that vary more than they should: the gamma-Poisson
#
# Adapted from "Modern Statistics for Modern Biology", Holmes & Huber,
# Chapter 4. See ../../book/src/attribution.md.
#
# Run:  bl run 03-overdispersion.bl

import "msmbstats/src/distributions"

# The most consequential mixture in biology is one nobody draws a picture of.
#
# Chapter 1 modelled counts with a Poisson. A Poisson has a property that looks
# harmless and is not: its variance equals its mean. One number fixes both.

println("== The Poisson's fixed relationship ==")
set_seed(2)
[1.0, 5.0, 20.0, 100.0] |> each(|lambda| {
    let draws = rpois(4000, lambda)
    println(f"  lambda {lambda:>6.1f}  ->  mean {mean(draws):>7.2f}   variance {variance(draws):>7.2f}")
})
println("")
println("Mean and variance track each other, as the model requires.")
println("")

# --- What real data does --------------------------------------------------

println("== What sequencing counts actually do ==")
println("")
println("Measure one gene across biological replicates - different mice, not")
println("the same sample twice - and the variance is far larger than the mean.")
println("Poisson counting noise is only the sampling step. The mice differ.")
println("")

# --- Building the fix -----------------------------------------------------

println("== Letting the rate itself vary ==")
println("")
println("Keep the Poisson for the sequencing, and let its rate differ from")
println("mouse to mouse. Draw the rate from a gamma, then draw the count from a")
println("Poisson with that rate. That two-stage process is a mixture with")
println("infinitely many components - one per possible rate.")
println("")

set_seed(7)
let target_mean = 20.0

println("  dispersion   mean   variance   var/mean")
[1000.0, 20.0, 5.0, 2.0, 1.0] |> each(|size| {
    let draws = rnbinom(3000, size, target_mean)
    let m = mean(draws)
    let v = variance(draws)
    println(f"  {size:>10.0f}  {m:>6.2f}   {v:>8.2f}   {v / m:>8.2f}")
})
println("")
println("The mixture has a name - the negative binomial - and a clean formula:")
println("")
println("      variance = mu + mu^2 / size")
println("")
println("Large `size` means the rate barely varies and the result is a Poisson")
println("(top row: variance ~ mean). Small `size` means the rate varies a lot,")
println("and the variance runs away. One extra parameter buys the freedom to")
println("describe data whose variance and mean are not locked together.")
println("")

# --- Why it matters ------------------------------------------------------

println("== The cost of using the wrong one ==")
println("")

# Two conditions with genuinely equal means. Any difference found is a false
# positive. Test them with a Poisson assumption and with the truth.
set_seed(11)
let replicates = 6
let true_size = 2.0
let trials = 400

let false_positives = range(0, trials) |> count_if(|_| {
    let a = rnbinom(replicates, true_size, 50.0)
    let b = rnbinom(replicates, true_size, 50.0)
    # A Poisson-based test: under Poisson, the variance of a total of n counts
    # is that total, so this is the standard two-sample Poisson comparison.
    let total_a = sum(a)
    let total_b = sum(b)
    let z = (total_a - total_b) * 1.0 / sqrt(total_a + total_b)
    abs(z) > 1.96
})

println(f"  {trials} comparisons of two groups with IDENTICAL true means")
println(f"  the data is overdispersed (size = {true_size}), the test assumes Poisson")
println("")
println(f"  significant at 5%: {false_positives} of {trials} ({false_positives * 100.0 / trials:.1f}%)")
println("")
println("A test calibrated to reject 5% of the time rejects far more, because")
println("it is comparing the observed difference against a yardstick built from")
println("Poisson variance - which is much smaller than the real variance. Every")
println("one of those is a gene someone would have called differentially")
println("expressed, written up, and failed to replicate.")
println("")
println("This is why DESeq2 and edgeR are built on the negative binomial rather")
println("than the Poisson, and why they spend most of their effort estimating")
println("the dispersion. It is not a refinement; it is the difference between a")
println("calibrated test and one that is wrong most of the time.")
