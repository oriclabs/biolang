# Normalization and PCA
#
# From 'The HBC Single-cell Course, in BioLang'.
# Follows the Harvard Chan Bioinformatics Core course 'Introduction to
# scRNA-seq' (CC BY 4.0) - https://hbctraining.github.io/Intro-to-scRNAseq/
#
# Setup (once):
#   bl install ./singlecell
#   python get-data.py
#
# Run:
#   bl run ch03.bl

# --------------------------------------------------------------------
# Block 1 of 4
# --------------------------------------------------------------------

import "singlecell" as sc

let obj = sc.load("ctrl_raw")
    |> sc.filter_genes(3)
    |> sc.filter_cells(250, 100000, 20.0)
    |> sc.normalize()
    |> sc.variable_genes(2000)
    |> sc.run_pca(30)

write_text("elbow.svg", sc.plot_elbow(obj, 30))

# --------------------------------------------------------------------
# Block 2 of 4
# --------------------------------------------------------------------

import "singlecell" as sc

let obj = sc.load("ctrl_raw")
    |> sc.filter_genes(3)
    |> sc.filter_cells(250, 100000, 20.0)
    |> sc.normalize(10000.0)

println("normalised layer present: " + str(contains(keys(obj), "norm_matrix")))

# --------------------------------------------------------------------
# Block 3 of 4
# --------------------------------------------------------------------

import "singlecell" as sc

let obj = sc.load("ctrl_raw")
    |> sc.filter_genes(3)
    |> sc.filter_cells(250, 100000, 20.0)
    |> sc.normalize()
    |> sc.variable_genes(2000)

println("HVGs: " + str(len(sc.get_hvg_genes(obj))))

# --------------------------------------------------------------------
# Block 4 of 4
# --------------------------------------------------------------------

import "singlecell" as sc

let obj = sc.load("ctrl_raw")
    |> sc.filter_genes(3)
    |> sc.filter_cells(250, 100000, 20.0)
    |> sc.sctransform()

println("sctransform applied to " + str(obj.n_cells) + " cells")

